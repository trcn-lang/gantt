function datePaques(annee){
  const a = annee % 19;
  const b = Math.floor(annee / 100);
  const c = annee % 100;
  const d = Math.floor(b / 4);
  const e = b % 4;
  const f = Math.floor((b + 8) / 25);
  const g = Math.floor((b - f + 1) / 3);
  const h = (19 * a + b - d - g + 15) % 30;
  const i = Math.floor(c / 4);
  const k = c % 4;
  const l = (32 + 2 * e + 2 * i - h - k) % 7;
  const m = Math.floor((a + 11 * h + 22 * l) / 451);
  const mois = Math.floor((h + l - 7 * m + 114) / 31);
  const jour = ((h + l - 7 * m + 114) % 31) + 1;
  return new Date(annee, mois - 1, jour);
}

function joursFeriesAnnee(annee){
  const paques = datePaques(annee);
  const addJours = (date, n) => { const d = new Date(date); d.setDate(d.getDate() + n); return d; };
  const cles = (d) => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
  const feries = [
    new Date(annee, 0, 1), addJours(paques, 1), new Date(annee, 4, 1), new Date(annee, 4, 8),
    addJours(paques, 39), addJours(paques, 50), new Date(annee, 6, 14), new Date(annee, 7, 15),
    new Date(annee, 10, 1), new Date(annee, 10, 11), new Date(annee, 11, 25),
  ];
  return new Set(feries.map(cles));
}

const CACHE_FERIES = {};
function estFerie(date){
  const annee = date.getFullYear();
  if(!CACHE_FERIES[annee]) CACHE_FERIES[annee] = joursFeriesAnnee(annee);
  const cle = `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`;
  return CACHE_FERIES[annee].has(cle);
}

function joursOuvres(d1, d2){
  let n=0;
  const cur=new Date(d1);
  while(cur<=d2){
    const j=cur.getDay();
    if(j!==0 && j!==6 && !estFerie(cur)) n++;
    cur.setDate(cur.getDate()+1);
  }
  return n;
}

// Utilitaires jours ouvrés pour la propagation PERT (chemin critique)
function estJourOuvre(date){
  const j=date.getDay();
  return j!==0 && j!==6 && !estFerie(date);
}
function jourOuvreSuivant(date){
  const d=new Date(date);
  d.setDate(d.getDate()+1);
  while(!estJourOuvre(d)) d.setDate(d.getDate()+1);
  return d;
}
function jourOuvrePrecedent(date){
  const d=new Date(date);
  d.setDate(d.getDate()-1);
  while(!estJourOuvre(d)) d.setDate(d.getDate()-1);
  return d;
}
// Renvoie la date de fin après n jours ouvrés en comptant "date" comme jour 1 (cohérent avec Duree_jours)
function ajouterJoursOuvres(date, n){
  const d=new Date(date);
  let restant=Math.max(1,n)-1;
  while(restant>0){
    d.setDate(d.getDate()+1);
    if(estJourOuvre(d)) restant--;
  }
  return d;
}
// Opération inverse : retrouve la date de début connaissant la fin et la durée en jours ouvrés
function soustraireJoursOuvres(date, n){
  const d=new Date(date);
  let restant=Math.max(1,n)-1;
  while(restant>0){
    d.setDate(d.getDate()-1);
    if(estJourOuvre(d)) restant--;
  }
  return d;
}
// ─── Calcul date/durée en temps réel (sans toggle, détection automatique) ────
// Règle simple :
//   Si le dernier champ modifié est "Durée" → on calcule Date_fin
//   Si le dernier champ modifié est "Date fin" → on calcule Durée
//   Si Date début change → on recalcule celui des deux qui est déjà rempli
// On stocke le "dernier intent" dans un attribut data pour éviter l'ambiguïté.

let _dernierChampModifie = null; // "duree" ou "fin"

function majDepuisDuree(){
  _dernierChampModifie = "duree";
  const debut = document.getElementById("field-tache-debut").value;
  const duree = parseInt(document.getElementById("field-tache-duree").value)||0;
  if(debut && duree>0){
    const fin = ajouterJoursOuvres(new Date(debut), duree);
    document.getElementById("field-tache-fin").value = toDateInput(Math.floor(fin.getTime()/1000));
  }
}

function majDepuisFin(){
  _dernierChampModifie = "fin";
  const debut = document.getElementById("field-tache-debut").value;
  const fin = document.getElementById("field-tache-fin").value;
  if(debut && fin){
    const n = joursOuvres(new Date(debut), new Date(fin));
    document.getElementById("field-tache-duree").value = n>0 ? n : "";
  }
}

function majDepuisDebut(){
  const debut = document.getElementById("field-tache-debut").value;
  if(!debut) return;
  if(_dernierChampModifie === "duree" || !_dernierChampModifie){
    majDepuisDuree();
  } else {
    majDepuisFin();
  }
}

