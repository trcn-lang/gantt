// ============================================================================
// GESTION DES FILTRES SECTION & PROJET (chips cliquables)
// ============================================================================
// IMPORTANT : les "sections" n'existent, en tant que valeurs, que via le champ
// Projets.Section (référence vers PARAMETRES). PARAMETRES.Section est le texte
// brut de la valeur elle-même (une ligne = un nom de section), donc on ne peut
// pas le "resolveRef" comme une référence — sinon on retombe sur des libellés
// de projets par erreur. On dérive donc la liste des sections en parcourant
// les projets, pas PARAMETRES directement.

function obtenirSectionsUniques(){
  // Retourne les sections réellement utilisées par des projets,
  // dans l'ordre d'apparition des projets (qui reflète l'ordre PARAMETRES
  // via l'ordre naturel d'ajout des projets).
  // IMPORTANT : on ne lit PAS la colonne "Section" en dur — Grist peut l'avoir
  // renommée (ex: "$Section2" en cas de doublon détecté par detectParametresSchema()).
  // Le reste du code (openProjetEdit, saveProjet) utilise déjà SCHEMA_PARAMETRES.section
  // pour cette raison ; on fait pareil ici pour rester cohérent.
  const colSection = SCHEMA_PARAMETRES.section || "Section";
  const vues = new Set();
  const sections = [];
  DB.projets.forEach(proj=>{
    const sid = refId(proj.Section);
    if(sid !== null && sid !== undefined && !vues.has(sid)){
      const nom = resolveRef(DB.parametres, proj.Section, colSection);
      if(nom){
        vues.add(sid);
        sections.push({id:sid, nom});
      }
    }
  });
  return sections;
}

function obtenirProjetsParSection(sectionIds){
  // Retourne les projets dont la Section est dans sectionIds.
  // Si aucune section n'est cochée, ne retourne rien : la liste "Projet"
  // reste vide tant qu'on n'a pas choisi une section (le Gantt, lui,
  // continue d'afficher tous les projets — voir construire()).
  if(sectionIds.size === 0) return [];
  return DB.projets.filter(proj=>sectionIds.has(refId(proj.Section)));
}

// Liste des projets RÉELLEMENT affichés dans le Gantt compte tenu des filtres
// Section/Projet actifs — même logique que celle utilisée dans construire()
// pour dessiner les lignes. Centralisée ici pour être réutilisée partout où
// on a besoin de savoir "quels projets sont visibles à l'écran" (ex: bouton
// "Début"), afin que ces deux notions ne puissent jamais diverger.
function obtenirProjetsAffiches(){
  let projetsAffichage = DB.projets;
  if(FILTRES_ACTIFS.projets.size > 0){
    projetsAffichage = DB.projets.filter(p=>FILTRES_ACTIFS.projets.has(p.id));
  } else if(FILTRES_ACTIFS.sections.size > 0){
    projetsAffichage = DB.projets.filter(p=>{
      const projSectionId = refId(p.Section);
      return FILTRES_ACTIFS.sections.has(projSectionId);
    });
  }
  return projetsAffichage;
}

function creerChip(label, isActive, onClick){
  const chip = document.createElement("button");
  chip.type = "button";
  chip.className = "filter-chip" + (isActive ? " active" : "");
  chip.textContent = label;
  chip.onclick = onClick;
  return chip;
}

function populerFiltresSection(){
  const container = document.getElementById("filter-sections-chips");
  container.innerHTML = "";
  const sections = obtenirSectionsUniques();

  if(sections.length === 0){
    container.innerHTML = '<span class="filter-chips-empty">Aucune section trouvée</span>';
    return;
  }

  sections.forEach(section=>{
    const isActive = FILTRES_ACTIFS.sections.has(section.id);
    const chip = creerChip(section.nom, isActive, ()=>{
      if(FILTRES_ACTIFS.sections.has(section.id)){
        FILTRES_ACTIFS.sections.delete(section.id);
      } else {
        FILTRES_ACTIFS.sections.add(section.id);
      }
      // Une section change → on réinitialise les projets cochés (cascade)
      FILTRES_ACTIFS.projets.clear();
      populerFiltresSection();
      populerFiltresProjets();
      construire();
    });
    container.appendChild(chip);
  });
}

function populerFiltresProjets(){
  const container = document.getElementById("filter-projets-chips");
  container.innerHTML = "";

  const projetsDisponibles = obtenirProjetsParSection(FILTRES_ACTIFS.sections);

  if(FILTRES_ACTIFS.sections.size === 0){
    container.innerHTML = '<span class="filter-chips-empty">Sélectionnez une section</span>';
    return;
  }
  if(projetsDisponibles.length === 0){
    container.innerHTML = '<span class="filter-chips-empty">Aucun projet dans cette section</span>';
    return;
  }

  projetsDisponibles.forEach(proj=>{
    const isActive = FILTRES_ACTIFS.projets.has(proj.id);
    const chip = creerChip(proj.Projet, isActive, ()=>{
      if(FILTRES_ACTIFS.projets.has(proj.id)){
        FILTRES_ACTIFS.projets.delete(proj.id);
      } else {
        FILTRES_ACTIFS.projets.add(proj.id);
      }
      populerFiltresProjets();
      construire();
    });
    container.appendChild(chip);
  });
}

async function init(){
  if(INIT_EN_COURS) return; // évite les appels concurrents (ex: cascade déclenchée par onRecords)
  INIT_EN_COURS = true;
  try{
    document.getElementById("status").textContent="Chargement...";
    DB.projets      = columnarToRows(await grist.docApi.fetchTable("Projets"));
    DB.jalons       = columnarToRows(await grist.docApi.fetchTable("Jalons"));
    DB.taches       = columnarToRows(await grist.docApi.fetchTable("Taches"));
    DB.parametres   = columnarToRows(await grist.docApi.fetchTable("PARAMETRES"));
    detectParametresSchema();  // ← Déterminer les vrais noms des champs
    DB.actions      = columnarToRows(await grist.docApi.fetchTable("ACTIONS"));
    exclureProjetsArchives();  // ← Retirer les projets archivés + tout ce qui en dépend

    // ✅ S'assurer qu'un agent "Non attribué" existe dans PARAMETRES.Equipe
    if(!NON_ATTRIBUE_VERIFIE){
      let nonAttribue = DB.parametres.find(r => norm(r.Equipe) === norm("Non attribué"));
      if(!nonAttribue){
        await grist.docApi.applyUserActions([["AddRecord","PARAMETRES",null,{Equipe:"Non attribué"}]]);
        DB.parametres = columnarToRows(await grist.docApi.fetchTable("PARAMETRES"));
        nonAttribue = DB.parametres.find(r => norm(r.Equipe) === norm("Non attribué"));
      }
      NON_ATTRIBUE_ID = nonAttribue ? nonAttribue.id : null;
      NON_ATTRIBUE_VERIFIE = true;
    } else {
      const nonAttribue = DB.parametres.find(r => norm(r.Equipe) === norm("Non attribué"));
      NON_ATTRIBUE_ID = nonAttribue ? nonAttribue.id : NON_ATTRIBUE_ID;
    }

    populateSelects();
    populerFiltresSection();
    populerFiltresProjets();
    construire();
    if(PREMIER_CHARGEMENT){
      PREMIER_CHARGEMENT = false;
      setTimeout(()=>scrollVersDebutVisible(false), 350); // false = pas d'animation, positionnement direct à l'ouverture
    }
    document.getElementById("status").textContent="✓ Données chargées";
  }catch(e){
    console.error("❌", e);
    document.getElementById("status").textContent="❌ "+e.message;
  }finally{
    INIT_EN_COURS = false;
  }
}

