async function deleteProjet(){
  const id=parseInt(document.getElementById("field-projet-id").value);
  if(!id) return;
  const tachesLiees=DB.taches.filter(t=>refId(t.Projet)===id);
  const jalonsLies=DB.jalons.filter(j=>refId(j.Projet)===id);
  const actionsLiees=tachesLiees.flatMap(t=>getActionsTache(t.id));
  const msg=`Ce projet contient ${tachesLiees.length} tâche(s), ${jalonsLies.length} jalon(s) et ${actionsLiees.length} sous-action(s). Tout supprimer ?`;
  if(!confirm(msg)) return;
  try{
    const actions=[];
    // Sous-actions d'abord : sans cela elles resteraient orphelines en base.
    actionsLiees.forEach(a=>actions.push(["RemoveRecord","ACTIONS",a.id]));
    tachesLiees.forEach(t=>actions.push(["RemoveRecord","Taches",t.id]));
    jalonsLies.forEach(j=>actions.push(["RemoveRecord","Jalons",j.id]));
    actions.push(["RemoveRecord","Projets",id]);
    await grist.docApi.applyUserActions(actions);
    closeModal("modal-projet");
    init();
  }catch(e){ alert("Erreur: "+e.message); console.error(e); }
}

// ============================================================================
// DUPLICATION / TEMPLATE DE PROJET RÉCURRENT
// ============================================================================
// Principe : chaque tâche/jalon du projet source est repéré par son décalage
// en JOURS OUVRÉS par rapport à l'élément qui finit le plus tard dans le
// projet (l'"ancrage", basé sur la Date_fin des tâches et la Date des jalons).
// À la duplication, l'utilisateur saisit la nouvelle DATE DE FIN cible (ex:
// date d'une CAP, d'un jury, d'une échéance réglementaire) et ce même
// décalage en jours ouvrés est réappliqué EN ARRIÈRE depuis cette date —
// cohérent avec le pilotage par échéance typique des processus RH, et avec
// le calcul de durée en jours ouvrés déjà utilisé partout ailleurs (§5.3, §5.4).
// La Date_debut de chaque tâche est toujours recalculée depuis sa Date_fin et
// sa Duree_jours (jamais décalée indépendamment), ce qui garantit que la durée
// d'origine est préservée à l'identique dans la copie.

let DUPLI_EN_COURS  = false; // gèle le rechargement auto pendant la séquence d'écritures
let DUPLI_SOURCE_ID = null;
let DUPLI_ANCRAGE   = null; // Date (objet Date) la plus tardive du projet source

// Décalage en jours ouvrés de `date` par rapport à `ancrage` (0 si identique,
// négatif si `date` est antérieure à `ancrage` — le cas normal ici, puisque
// l'ancrage est la date de fin la plus tardive du projet).
function offsetOuvresDepuis(ancrage, date){
  if(date.getTime() >= ancrage.getTime()) return joursOuvres(ancrage, date) - 1;
  return -(joursOuvres(date, ancrage) - 1);
}
// Applique un décalage en jours ouvrés à une date d'ancrage donnée.
function dateDecaleeOuvree(ancrage, offset){
  if(offset >= 0) return ajouterJoursOuvres(ancrage, offset + 1);
  return soustraireJoursOuvres(ancrage, Math.abs(offset) + 1);
}

// Renvoie l'ancrage du rétroplanning ainsi que les listes de tâches/jalons.
// L'ancre suit la même définition que la Date_cible d'un projet (cf. §5.2) :
//   1. dernier jalon Livrable *Fixe*  (échéance à ancrage hiérarchique dur)
//   2. à défaut, dernier jalon Livrable
//   3. à défaut, date la plus tardive du projet (fin de tâche ou jalon)
// Motivation : dans un processus RH, l'échéance qui structure le rétroplanning
// est le livrable (CAP, jury, publication), pas une tâche de clôture
// administrative qui pourrait traîner après lui.
function calculerAncrageEtItems(projetId){
  const taches = DB.taches.filter(t=>refId(t.Projet)===projetId);
  const jalons = DB.jalons.filter(j=>refId(j.Projet)===projetId);

  function plusTardif(liste, getDate){
    let best = null;
    liste.forEach(x=>{
      const d = getDate(x);
      if(d && (!best || d > best.date)) best = { date:d, element:x };
    });
    return best;
  }

  const livrables = jalons.filter(j=>norm(getJalonTypeTexte(j))===norm("Livrable"));

  let choix = plusTardif(livrables.filter(j=>j.Important===true), j=>parseDate(j.Date));
  if(choix) return { ancrage:choix.date, ancrageLibelle:`Livrable fixe « ${choix.element.Nom} »`, taches, jalons };

  choix = plusTardif(livrables, j=>parseDate(j.Date));
  if(choix) return { ancrage:choix.date, ancrageLibelle:`Livrable « ${choix.element.Nom} »`, taches, jalons };

  const candidats = [];
  taches.forEach(t=>{ const d=parseDate(t.Date_fin); if(d) candidats.push({date:d, nom:t.Tache}); });
  jalons.forEach(j=>{ const d=parseDate(j.Date); if(d) candidats.push({date:d, nom:j.Nom}); });
  if(!candidats.length) return { ancrage:null, ancrageLibelle:null, taches, jalons };
  candidats.sort((a,b)=>b.date-a.date);
  return {
    ancrage: candidats[0].date,
    ancrageLibelle: `dernière échéance « ${candidats[0].nom} » (aucun livrable défini)`,
    taches, jalons
  };
}

