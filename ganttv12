  const input = document.createElement("input");
  input.type = "text";
  input.className = "action-input-create";
  input.placeholder = "Taper le nom de la sous-action...";
  input.maxLength = 100;

  input.onkeydown = async (e) => {
    if(e.key === "Enter"){
      e.preventDefault();
      const nom = input.value.trim();
      if(!nom) return;

      try {
        const existantes = getActionsTache(tacheId);
        const ordre = existantes.length + 1;
        const statutId = findParamId("Statut", "À faire");

        await grist.docApi.applyUserActions([
          ["AddRecord", "ACTIONS", null, {
            Tache: tacheId,
            Nom: nom,
            Ordre: ordre,
