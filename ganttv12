<script>
const STATUTS = [
  {nom:"À faire",   cls:"st-faire",    couleur:"var(--st-faire)"},
  {nom:"En cours",  cls:"st-encours",  couleur:"var(--st-encours)"},
  {nom:"Terminé",   cls:"st-termine",  couleur:"var(--st-termine)"},
];

const JALON_COULEURS = {
  "jalon majeur": "var(--jalon-majeur)",
  "livrable":     "var(--jalon-livrable)",
  "pour information": "var(--jalon-info)",
};
// jalonCouleur retourne la couleur du jalon selon son type ET son flag Important.
// Si Important=true ET Type="Livrable" → rouge critique (ancien "Jalon majeur")
// Sinon → couleur standard du type
function jalonCouleur(type, important){
  if(norm(type) === norm("Livrable") && important === true){
    return "var(--critique)";  // Rouge pour les Livrables Important
  }
  return JALON_COULEURS[norm(type)] || "var(--jalon-info)";
}

function norm(s){
  return String(s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").trim();
}
function statutInfo(s){
  return STATUTS.find(x=>norm(x.nom)===norm(s)) || {nom:s||"—",cls:"st-faire",couleur:"var(--st-faire)"};
}
function cssVarValue(v){
  return getComputedStyle(document.documentElement).getPropertyValue(v.replace("var(","").replace(")","").trim())||v;
}

function parseDate(v){
  if(v===null||v===undefined||v==="") return null;
  if(typeof v==="number") return new Date(v*1000);
  const d=new Date(String(v).trim());
  return isNaN(d.getTime())?null:d;
}
function dayIndex(v){
  const d=parseDate(v);
  return d?Math.floor(d.getTime()/86400000):null;
}
function refId(v){
  if(Array.isArray(v)) return v[1];
  return v;
}
function resolveRef(table, id, col){
  const rid=refId(id);
  if(rid===null||rid===undefined) return null;
  const ligne=table.find(row=>row.id===rid);
  return ligne?ligne[col]:null;
}
function fmtJourComplet(v){
  const d=parseDate(v);
  if(!d) return "";
  const jours=['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  const jj=String(d.getUTCDate()).padStart(2,"0");
  const mm=String(d.getUTCMonth()+1).padStart(2,"0");
  return `${jours[d.getUTCDay()]} ${jj}/${mm}`;
}
function fmtDateCourt(v){
  const d=parseDate(v);
  if(!d) return "";
  const jj=String(d.getUTCDate()).padStart(2,"0");
  const mm=String(d.getUTCMonth()+1).padStart(2,"0");
  return `${jj}/${mm}`;
}
function toDateInput(v){
  const d=parseDate(v);
  if(!d) return "";
  const jj=String(d.getUTCDate()).padStart(2,"0");
  const mm=String(d.getUTCMonth()+1).padStart(2,"0");
  return `${d.getUTCFullYear()}-${mm}-${jj}`;
}

let DB={};
let NON_ATTRIBUE_ID = null;
let allData={};

let COLLAPSED_PROJETS = new Set();

// ========== FILTRES SECTION / PROJET ==========
let FILTRES_ACTIFS = {
  sections: new Set(),  // IDs de sections cochées
  projets: new Set()    // IDs de projets cochés
};

// ========== ZOOM ==========
let JOUR_PX = 16;
const ZOOM_DEFAUT = 16;
// Limite de conception : un projet peut s'étaler jusqu'à 2*365 = 730 jours.
// ZOOM_MIN doit être assez bas pour que "Vue d'ensemble" puisse faire tenir
// 730 jours même sur une fenêtre de widget relativement étroite (~800px).
const LIMITE_PROJET_JOURS = 730;
const ZOOM_MIN = 0.5;
const ZOOM_MAX = 32;
const ZOOM_STEP = 4;
const LABEL_W = 300; // doit correspondre à --label-w
let ZOOM_CENTER_DAY = null; // jour absolu à recentrer après un zoom (null = comportement par défaut)

function setJourPx(px){
  // Pas d'arrondi ici : un arrondi vers le haut (ex: 1.9 -> 2) peut suffire
  // à faire dépasser la largeur disponible et laisser une barre de scroll
  // résiduelle après un calcul "Vue d'ensemble". Le CSS gère très bien les
  // valeurs fractionnaires de pixels.
  JOUR_PX = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, px));
  document.documentElement.style.setProperty("--jour", JOUR_PX + "px");
  const label = document.getElementById("zoom-level-label");
  if(label) label.textContent = Math.round((JOUR_PX / ZOOM_DEFAUT) * 100) + "%";
}

function capturerCentreJour(){
  const scrollDiv = document.getElementById("timeline-scroll");
  if(!scrollDiv || !allData || allData.minI === undefined) return null;
  const centreX = scrollDiv.scrollLeft + Math.max(0, (scrollDiv.clientWidth - LABEL_W)) / 2;
  const centreJourOffset = centreX / JOUR_PX;
  return allData.minI + centreJourOffset;
}

function zoomAvant(){
  ZOOM_CENTER_DAY = capturerCentreJour();
  setJourPx(JOUR_PX + ZOOM_STEP);
  construire();
}
function zoomArriere(){
  ZOOM_CENTER_DAY = capturerCentreJour();
  setJourPx(JOUR_PX - ZOOM_STEP);
  construire();
}
function zoomReinitialiser(){
  ZOOM_CENTER_DAY = capturerCentreJour();
  setJourPx(ZOOM_DEFAUT);
  construire();
}
function zoomVueEnsemble(){
  const scrollDiv = document.getElementById("timeline-scroll");
  if(!scrollDiv || !allData || !allData.totalJours) return;
  const largeurDispo = Math.max(100, scrollDiv.clientWidth - LABEL_W - 24);
  // Petite marge de sécurité (3%) pour absorber les arrondis de rendu
  // (bordures, paddings) et éviter qu'une barre de scroll résiduelle
  // n'apparaisse malgré un calcul "pile poil".
  const pxParJour = (largeurDispo / allData.totalJours) * 0.97;
  ZOOM_CENTER_DAY = null; // on veut voir depuis le début, pas centré
  setJourPx(pxParJour);
  construire();
  setTimeout(()=>{ scrollDiv.scrollLeft = 0; }, 320);
}

// Centre la vue sur la date du jour, sans changer le niveau de zoom.
function allerAujourdhui(){
  const scrollDiv = document.getElementById("timeline-scroll");
  if(!scrollDiv || !allData || allData.todayOffset === undefined) return;
  // Une seule formule de positionnement, réutilisée partout : plus de double
  // calcul (ZOOM_CENTER_DAY + rebuild complet du Gantt) qui pouvait diverger
  // ou se baser sur un clientWidth mesuré trop tôt quand le DOM est volumineux
  // (beaucoup de projets/tâches → reflow plus lent).
  const cible = allData.todayOffset*JOUR_PX - Math.max(0, (scrollDiv.clientWidth - LABEL_W)) / 2;
  scrollDiv.scrollTo({left: Math.max(0, cible), behavior: "smooth"});
}

function allerDebut(){
  const scrollDiv = document.getElementById("timeline-scroll");
  if(!scrollDiv || !allData) return;
  const minVisible = calculerPremiereDateVisible();
  if(minVisible === null) return;
  // Contrairement à "Aujourd'hui", on ne centre pas : on amène la première
  // date visible juste après le bord gauche, avec une petite marge de confort.
  const offsetDebut = (minVisible - allData.minI) * JOUR_PX;
  scrollDiv.scrollTo({left: Math.max(0, offsetDebut - 20), behavior: "smooth"});
}

// Première date parmi les tâches/jalons des projets NON pliés uniquement.
// Distinct de allData.minI (qui lui reste stable, calculé sur tous les
// projets, pour ne jamais faire bouger l'échelle horizontale au pli/dépli —
// voir le fix "plier un projet décale toute la frise").
function calculerPremiereDateVisible(){
  // "Visible" = ni replié (COLLAPSED_PROJETS) NI masqué par les filtres
  // Section/Projet actifs (FILTRES_ACTIFS). Avant ce correctif, seul le pli
  // était pris en compte : filtrer un projet spécifique le laissait quand
  // même compter dans le calcul, et le bouton "Début" scrollait alors vers
  // une date appartenant à un projet invisible à l'écran (semblait "ne rien faire").
  const projetsAffichesIds = new Set(obtenirProjetsAffiches().map(p=>p.id));
  const dates = [];
  DB.taches.forEach(t => {
    const pid = refId(t.Projet);
    if(COLLAPSED_PROJETS.has(pid)) return;
    if(!projetsAffichesIds.has(pid)) return;
    const dIdx = dayIndex(t.Date_debut);
    if(dIdx !== null) dates.push(dIdx);
  });
  DB.jalons.forEach(j => {
    const pid = refId(j.Projet);
    if(COLLAPSED_PROJETS.has(pid)) return;
    if(!projetsAffichesIds.has(pid)) return;
    const dIdx = dayIndex(j.Date);
    if(dIdx !== null) dates.push(dIdx);
  });
  return dates.length > 0 ? Math.min(...dates) : null;
}

// Scroll auto (alignement à gauche, pas de centrage) vers la première date
// visible : déclenché à l'ouverture du Gantt et au dépli d'un projet.
function scrollVersDebutVisible(smooth){
  const scrollDiv = document.getElementById("timeline-scroll");
  if(!scrollDiv || !allData) return;
  const minVisible = calculerPremiereDateVisible();
  if(minVisible === null) return;
  const offsetDebut = (minVisible - allData.minI) * JOUR_PX;
  scrollDiv.scrollTo({left: Math.max(0, offsetDebut - 20), behavior: smooth ? "smooth" : "auto"});
}

grist.ready({requiredAccess:"full"});

function columnarToRows(data){
  if(!data || typeof data!=="object") return [];
  if(Array.isArray(data)) return data;
  const keys=Object.keys(data);
  if(keys.length===0) return [];
  const firstCol=data[keys[0]];
  if(!Array.isArray(firstCol)) return [];
  const rows=[];
  for(let i=0;i<firstCol.length;i++){
    const row={};
    keys.forEach(k=>row[k]=data[k][i]);
    rows.push(row);
  }
  return rows;
}

// Retire des données en mémoire tout projet archivé (colonne Projets.$Archive
// cochée) ainsi que tout ce qui en dépend (tâches, jalons, sous-actions).
// Appelée juste après le chargement, une seule fois : plus aucune fonction
// du widget n'a ensuite connaissance des projets archivés — évite d'avoir à
// ajouter une vérification "si Archive alors ignorer" dans chaque filtre,
// chaque liste déroulante, chaque calcul (source d'oublis, cf. Kanban).
function exclureProjetsArchives(){
  DB.projets = DB.projets.filter(p => p['$Archive'] !== true);
  const projetsVisiblesIds = new Set(DB.projets.map(p => p.id));
  DB.taches = (DB.taches || []).filter(t => projetsVisiblesIds.has(refId(t.Projet)));
  DB.jalons = (DB.jalons || []).filter(j => projetsVisiblesIds.has(refId(j.Projet)));
  if(DB.actions){
    const tachesVisiblesIds = new Set(DB.taches.map(t => t.id));
    DB.actions = DB.actions.filter(a => tachesVisiblesIds.has(refId(a.Tache)));
  }
}

function getPredecessorTasks(task){
  const raw = task.Predecesseurs;
  if(!raw) return [];
  if(!Array.isArray(raw)) return [];
  if(raw[0] === 'L'){
    return raw.slice(1).map(id => DB.taches.find(t => t.id === id)).filter(Boolean);
  }
  if(raw[0] === 'E'){
    console.warn("⚠️ Cellule Predecesseurs corrompue pour la tâche", task.id);
    return [];
  }
  return raw.map(id => (typeof id === 'object' ? id : DB.taches.find(t => t.id === id))).filter(Boolean);
}

function getPredecessorsBlocked(task){
  const preds = getPredecessorTasks(task);
  return preds.filter(pred => {
    const predStatut = resolveRef(DB.parametres, pred.Statut, "Statut");
    return norm(predStatut) !== norm("Terminé");
  });
}

// Liens Livrable : un jalon peut requérir des tâches, une tâche peut être déclenchée par des jalons
function parseListeReference(raw, table){
  if(!raw) return [];
  if(!Array.isArray(raw)) return [];
  if(raw[0] === 'L'){
    return raw.slice(1).map(id => table.find(x => x.id === id)).filter(Boolean);
  }
  if(raw[0] === 'E') return [];
  return raw.map(id => (typeof id === 'object' ? id : table.find(x => x.id === id))).filter(Boolean);
}
function getJalonTachesRequises(jalon){
  return parseListeReference(jalon.Taches_requises, DB.taches);
}
// Décode le format "Choix multiple" de Grist (['L', 'Livrable']) en simple texte
function getJalonTypeTexte(jalon){
  const raw = jalon.Type;
  if(!raw) return "";
  if(Array.isArray(raw)){
    if(raw[0]==='L') return raw[1] || "";
    if(raw[0]==='E') return "";
    return "";
  }
  return raw;
}
function getTacheJalonsDeclencheurs(task){
  return parseListeReference(task.Jalon_declencheur, DB.jalons);
}
// Date_cible d'un projet = date du dernier Livrable Important.
// Fallback : si aucun Livrable Important, date du dernier Livrable (tout court).
// Calculée à la volée (pas de formule Grist), recalculée à chaque construire().
function getJalonTachesRequisesNonTerminees(jalon){
  return getJalonTachesRequises(jalon).filter(t=>{
    const statutTexte = resolveRef(DB.parametres, t.Statut, "Statut");
    return norm(statutTexte) !== norm("Terminé");
  });
}
// Un jalon-livrable est "atteint" si toutes ses tâches requises sont Terminé
// (à défaut de tâche requise liée, on se base sur sa date)
function getJalonAtteint(jalon){
  const requises = getJalonTachesRequises(jalon);
  if(requises.length > 0){
    return requises.every(t => norm(resolveRef(DB.parametres, t.Statut, "Statut")) === norm("Terminé"));
  }
  const d = parseDate(jalon.Date);
  return d ? (Date.now() >= d.getTime()) : false;
}
// Jalons-livrables que CETTE tâche conditionne (elle fait partie de leurs Taches_requises)
function getJalonsConditionnesParTache(task){
  return DB.jalons.filter(j => norm(getJalonTypeTexte(j))===norm("Livrable") && getJalonTachesRequises(j).some(t=>t.id===task.id));
}

// Détection de cycle unifiée sur le graphe mixte Tâches + Jalons (liens Livrable)
// nodeKey format : "T:<id>" pour une tâche, "J:<id>" pour un jalon
function getSuccessorsUnifies(nodeKey){
  const [type, idStr] = nodeKey.split(':');
  const id = parseInt(idStr);
  const succ = [];
  if(type === 'T'){
    DB.taches.forEach(t=>{ if(getPredecessorTasks(t).some(p=>refId(p.id||p)===id)) succ.push('T:'+t.id); });
    DB.jalons.forEach(j=>{ if(getJalonTachesRequises(j).some(x=>x.id===id)) succ.push('J:'+j.id); });
  } else {
    DB.taches.forEach(t=>{ if(getTacheJalonsDeclencheurs(t).some(x=>x.id===id)) succ.push('T:'+t.id); });
  }
  return succ;
}
function isDescendantUnifie(startKey, candidateKey, visited){
  visited = visited || new Set();
  if(startKey === candidateKey) return true;
  if(visited.has(startKey)) return false;
  visited.add(startKey);
  for(const succ of getSuccessorsUnifies(startKey)){
    if(isDescendantUnifie(succ, candidateKey, visited)) return true;
  }
  return false;
}

function isDescendant(taskId, candidateId, visited){
  visited = visited || new Set();
  if(taskId === candidateId) return true;
  if(visited.has(taskId)) return false;
  visited.add(taskId);
  const successeurs = DB.taches.filter(t => getPredecessorTasks(t).some(p => refId(p.id||p) === taskId));
  for(const succ of successeurs){
    if(isDescendant(succ.id, candidateId, visited)) return true;
  }
  return false;
}

// Calcule les tâches structurellement "en retard" : une tâche T2 est en retard
// si l'un de ses prédécesseurs T1 a une Date_fin postérieure à la Date_debut de T2
// (l'enchaînement logique des dates n'est plus respecté). Idem pour un jalon dont
// une Taches_requises finit après la date du jalon.
// Ne modifie aucune donnée Grist : recalculé à la volée à chaque construire().
function calculerRetardsStructurels(){
  const provoque = {}; // "T:id" ou "J:id" -> [ {genre,nom} ... ] (ce que cet élément met en retard)
  const subit    = {}; // "T:id" ou "J:id" -> [ nom du/des responsable(s) ]

  function ajouterProvoque(cleSource, genre, nom){
    (provoque[cleSource] = provoque[cleSource]||[]).push({genre,nom});
  }
  function ajouterSubit(cleCible, nomResponsable){
    (subit[cleCible] = subit[cleCible]||[]).push(nomResponsable);
  }

  DB.taches.forEach(t=>{
    const finT = parseDate(t.Date_fin);
    if(!finT) return;

    // Successeurs tâches (Predecesseurs)
    DB.taches.forEach(s=>{
      if(s.id===t.id) return;
      const estSuccesseur = getPredecessorTasks(s).some(p=>refId(p.id||p)===t.id);
      if(!estSuccesseur) return;
      const debutS = parseDate(s.Date_debut);
      if(debutS && finT > debutS){
        ajouterProvoque(`T:${t.id}`, "tache", s.Tache);
        ajouterSubit(`T:${s.id}`, t.Tache);
      }
    });

    // Successeurs jalons (Taches_requises)
    DB.jalons.forEach(j=>{
      if(norm(getJalonTypeTexte(j))!==norm("Livrable")) return;
      const estRequise = getJalonTachesRequises(j).some(rt=>rt.id===t.id);
      if(!estRequise) return;
      const dateJ = parseDate(j.Date);
      if(dateJ && finT > dateJ){
        ajouterProvoque(`T:${t.id}`, "jalon", j.Nom);
        ajouterSubit(`J:${j.id}`, t.Tache);
      }
    });
  });

  return { provoque, subit };
}

// Accès pratique : le badge "provoque" et "subit" d'un élément donné.
function getRetardStructurel(genre, id){
  const cle = (genre==="tache"?"T:":"J:")+id;
  const r = RETARDS_STRUCTURELS || {provoque:{},subit:{}};
  return {
    provoque: r.provoque[cle] || [],
    subit:    r.subit[cle]    || []
  };
}
let RETARDS_STRUCTURELS = {provoque:{}, subit:{}};

