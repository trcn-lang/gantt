function getActionsTache(tacheId){
  return DB.actions
    .filter(a => refId(a.Tache) === tacheId)
    .sort((a, b) => (a.Ordre || 0) - (b.Ordre || 0));
}

function displayActionsInModal(tacheId){
  const container = document.getElementById("sous-actions-list");
  container.innerHTML = "";

  if(!tacheId){
    container.innerHTML = '<div style="padding:12px;color:var(--texte-mention);font-size:12px;text-align:center;">Aucune sous-action</div>';
    return;
  }

  const actions = getActionsTache(tacheId);

  if(actions.length === 0){
    container.innerHTML = '<div style="padding:12px;color:var(--texte-mention);font-size:12px;text-align:center;">Aucune sous-action</div>';
  } else {
    actions.forEach(action => {
      const item = document.createElement("div");
      item.className = "action-item";

      const statutTexte = resolveRef(DB.parametres, action.Statut, "Statut");
      const equipeTexte = resolveRef(DB.parametres, action.Equipe, "Equipe") || "Non attribué";

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = norm(statutTexte) === norm("Terminé");
      checkbox.onchange = async (e) => {
        const newStatut = e.target.checked ? "Terminé" : "À faire";
        const newStatutId = findParamId("Statut", newStatut);
        await grist.docApi.applyUserActions([
          ["UpdateRecord", "ACTIONS", action.id, {Statut: newStatutId}]
        ]);
        init();
      };
      item.appendChild(checkbox);

      const nomSpan = document.createElement("span");
      nomSpan.className = "action-nom";
      nomSpan.textContent = action.Nom;
      item.appendChild(nomSpan);

      const equipeSpan = document.createElement("span");
      equipeSpan.className = "action-equipe";
      equipeSpan.textContent = equipeTexte;
      item.appendChild(equipeSpan);

      const actionsDiv = document.createElement("div");
      actionsDiv.className = "action-actions";

      const btnEdit = document.createElement("button");
      btnEdit.type = "button";
      btnEdit.className = "btn-edit-action";
      btnEdit.textContent = "✏";
      btnEdit.onclick = (e) => { e.stopPropagation(); openActionModal(tacheId, action.id); };
      actionsDiv.appendChild(btnEdit);

      const btnDelete = document.createElement("button");
      btnDelete.type = "button";
      btnDelete.className = "btn-delete-action";
      btnDelete.textContent = "🗑";
      btnDelete.onclick = async (e) => {
        e.stopPropagation();
        if(confirm("Supprimer cette sous-action?")){
          await grist.docApi.applyUserActions([
            ["RemoveRecord", "ACTIONS", action.id]
          ]);
          init();
        }
      };
      actionsDiv.appendChild(btnDelete);

      item.appendChild(actionsDiv);
      container.appendChild(item);
    });
  }
}

function activateCreateInput(tacheId){
  const area = document.getElementById("sous-action-create-area");
