async function saveJalon(){
  const id=document.getElementById("field-jalon-id").value;
  const projet_id=parseInt(document.getElementById("field-jalon-projet").value);
  const nom=document.getElementById("field-jalon-nom").value.trim();
  const date=document.getElementById("field-jalon-date").value;
  const type=document.getElementById("field-jalon-type").value;
  const fixe=document.getElementById("field-jalon-fixe").checked;
  const commentaires=document.getElementById("field-jalon-commentaires").value.trim();
  if(!nom || !date){ alert("Champs obligatoires"); return; }
  try{
    const checkboxes = document.querySelectorAll("#field-jalon-taches-requises input[type='checkbox']:checked");
    const tachesRequisesIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    if(id){
      const jalonKey = 'J:'+id;
      for(const taskId of tachesRequisesIds){
        if(isDescendantUnifie(jalonKey, 'T:'+taskId)){
          alert("❌ Cycle détecté : cette tâche requise créerait une boucle avec ce jalon. Sélection annulée.");
          return;
        }
      }
    }
    // Détecter si la date a changé (pour déclencher la cascade)
    const ancienJalon = id ? DB.jalons.find(j=>j.id===parseInt(id)) : null;
    const nouvelleDate = Math.floor(new Date(date).getTime()/1000);
    const dateChangee = ancienJalon && ancienJalon.Date !== nouvelleDate;

    const values={
      Projet:projet_id, Nom:nom, Date:nouvelleDate,
      Type: type ? ['L', type] : null,
      Important: fixe,
      Commentaires: commentaires || null,
      Taches_requises: ['L', ...tachesRequisesIds]
    };
    if(id){
      await grist.docApi.applyUserActions([["UpdateRecord","Jalons",parseInt(id),values]]);
    }else{
      await grist.docApi.applyUserActions([["AddRecord","Jalons",null,values]]);
    }
    await init();
    construire();
    // Cascade automatique si la date a changé
    if(dateChangee && ancienJalon){
      const jalonMisAJour = DB.jalons.find(j=>j.id===parseInt(id));
      if(jalonMisAJour){
        const impacts = calculerCascadeDepuisJalon(jalonMisAJour);
        if(impacts.length > 0){
          // Conserver l'état AVANT modif pour permettre un vrai "Annuler"
          LAST_CASCADE_ANCIEN_ETAT = {
            genre: "jalon",
            id: ancienJalon.id,
            valeurs: {
              Projet: ancienJalon.Projet,
              Nom: ancienJalon.Nom,
              Date: ancienJalon.Date,
              Type: ancienJalon.Type,
              Important: ancienJalon.Important,
              Commentaires: ancienJalon.Commentaires,
              Taches_requises: ancienJalon.Taches_requises,
            }
          };
          afficherRecapCascade("jalon", jalonMisAJour.Nom, impacts);
          return; // modale cascade gère la fermeture
        }
      }
    }
    closeModal("modal-jalon");
  }catch(e){ alert("Erreur: "+e.message); console.error(e); }
}

