  }
  if(blocked.length > 0){
    ajouterLigneDep("🔴", `Bloqué par : ${blocked.map(p => p.Tache || p).join(", ")}`);
  }
  if(jalonsNonAtteints.length > 0){
    ajouterLigneDep("🔶", `En attente de : ${jalonsNonAtteints.map(j => j.Nom).join(", ")}`);
  }
  if(jalonsConditionnesNonAtteints.length > 0){
    ajouterLigneDep("🔶", `Conditionne : ${jalonsConditionnesNonAtteints.map(j => j.Nom).join(", ")}`);
  }
  if(preds.length > 0){
    ajouterLigneDep("🟡", `Dépend de : ${preds.map(p => p.Tache || p).join(", ")}`);
  }
  infoDiv.style.display = auMoinsUneLigne ? "block" : "none";

  populatePredecessorsSelect(refId(t.Projet), preds);
  populateJalonsDeclencheursSelect(refId(t.Projet), jalonsDecl);
  displayActionsInModal(t.id);
  openModal("modal-tache");
