// Recalcule l'aperçu (décalage + liste tâches/jalons) à chaque frappe.
function majApercuDuplication(){
  const nom = document.getElementById("field-dupli-nom").value.trim();
  const dateVal = document.getElementById("field-dupli-date-fin").value;
  const btn = document.getElementById("btn-confirmer-dupliquer");
  const infoDiv = document.getElementById("dupli-info");
  const apercuWrap = document.getElementById("dupli-apercu");
  const apercuList = document.getElementById("dupli-apercu-list");

  if(!DUPLI_ANCRAGE || !dateVal || !nom){
    btn.disabled = true;
    apercuWrap.style.display = "none";
    if(DUPLI_ANCRAGE){ infoDiv.style.display = "none"; }
    return;
  }

  const nouvelleAncrage = new Date(dateVal);
  const { taches, jalons } = calculerAncrageEtItems(DUPLI_SOURCE_ID);
  const nbActions = taches.reduce((n,t)=> n + getActionsTache(t.id).length, 0);

  const items = [];
  taches.forEach(t=>{
    const d = parseDate(t.Date_fin);
    if(!d) return;
    const offset = offsetOuvresDepuis(DUPLI_ANCRAGE, d);
    const nouvelleFin = dateDecaleeOuvree(nouvelleAncrage, offset);
    const duree = t.Duree_jours || 1;
    items.push({
      genre:"tache", nom:t.Tache,
      oldDate:d, newDate:nouvelleFin,
      newDebut: soustraireJoursOuvres(nouvelleFin, duree)
    });
  });
  jalons.forEach(j=>{
    const d = parseDate(j.Date);
    if(!d) return;
    const offset = offsetOuvresDepuis(DUPLI_ANCRAGE, d);
    items.push({ genre:"jalon", nom:j.Nom, oldDate:d, newDate: dateDecaleeOuvree(nouvelleAncrage, offset) });
  });
  items.sort((a,b)=>a.oldDate-b.oldDate);

  const deltaOuvre = offsetOuvresDepuis(DUPLI_ANCRAGE, nouvelleAncrage);
  // Premier démarrage du nouveau rétroplanning (date la plus précoce calculée)
  const premierDebut = items.length ? new Date(Math.min(...items.map(i=>i.newDebut ? i.newDebut.getTime() : i.newDate.getTime()))) : null;
  const aujourdhui = new Date(); aujourdhui.setHours(0,0,0,0);
  const demarrePasse = premierDebut && premierDebut < aujourdhui;

  infoDiv.className = demarrePasse ? "info-box warning" : "info-box";
  infoDiv.style.display = "block";
  infoDiv.textContent = `${taches.length} tâche(s), ${jalons.length} jalon(s), ${nbActions} sous-action(s) seront dupliqués. `
    + `Décalage : ${deltaOuvre >= 0 ? "+" : ""}${deltaOuvre} jour(s) ouvré(s) `
    + `(échéance actuelle : ${fmtJourComplet(Math.floor(DUPLI_ANCRAGE.getTime()/1000))} → nouvelle échéance : ${fmtJourComplet(Math.floor(nouvelleAncrage.getTime()/1000))}).`;
  if(demarrePasse){
    infoDiv.textContent += ` ⚠️ Avec cette échéance, le rétroplanning devrait démarrer le ${fmtJourComplet(Math.floor(premierDebut.getTime()/1000))}, soit dans le passé : l'échéance est trop proche pour tenir le processus complet.`;
  }

  apercuList.innerHTML = "";
  items.forEach(item=>{
    const ligne = document.createElement("div");
    ligne.className = "cascade-recap-line";
    const icone = document.createElement("span");
    icone.textContent = item.genre==="jalon" ? "◆" : "▶";
    icone.style.cssText = "font-size:10px;opacity:0.6;flex-shrink:0";
    ligne.appendChild(icone);
    const nomEl = document.createElement("span");
    nomEl.className = "nom-element";
    nomEl.textContent = item.nom;
    ligne.appendChild(nomEl);
    const dates = document.createElement("span");
    dates.className = "dates-shift";
    dates.textContent = `${fmtJourComplet(Math.floor(item.oldDate.getTime()/1000))} → ${fmtJourComplet(Math.floor(item.newDate.getTime()/1000))}`;
    ligne.appendChild(dates);
    apercuList.appendChild(ligne);
  });
  apercuWrap.style.display = items.length ? "block" : "none";

  btn.disabled = false;
}

async function confirmerDuplicationProjet(){
  const projetId = DUPLI_SOURCE_ID;
  const proj = DB.projets.find(p=>p.id===projetId);
  const nouveauNom = document.getElementById("field-dupli-nom").value.trim();
  const dateVal = document.getElementById("field-dupli-date-fin").value;
  if(!proj || !nouveauNom || !dateVal || !DUPLI_ANCRAGE){ alert("Champs obligatoires manquants"); return; }
  const nouvelleAncrage = new Date(dateVal);

  const btn = document.getElementById("btn-confirmer-dupliquer");
  btn.disabled = true;
  btn.textContent = "Duplication en cours…";

  // La duplication enchaîne 5 écritures successives ; chacune déclenche
  // grist.onRecords → init(), qui rechargerait DB en pleine séquence.
  // On gèle ce rechargement jusqu'au init() final, maîtrisé.
  DUPLI_EN_COURS = true;
  try{
    const { taches, jalons } = calculerAncrageEtItems(projetId);
    const idsTachesSource = new Set(taches.map(t=>t.id));
    const idsJalonsSource = new Set(jalons.map(j=>j.id));
    const statutAFaireId = findParamId("Statut", "À faire");
    let refsExternesIgnorees = 0;

    // 1. Nouveau Projet (même Section / Type / Description que la source)
    const resProjet = await grist.docApi.applyUserActions([
      ["AddRecord","Projets",null,{
        Projet: nouveauNom,
        Section: refId(proj.Section),
        Type_Projet: refId(proj.Type_Projet),
        Description: proj.Description || ""
      }]
    ]);
    const nouveauProjetId = resProjet.retValues[0];

    // 2. Nouvelles Tâches — ancrées sur leur Date_fin (la Date_debut est
    //    recalculée en arrière depuis la durée). Statut réinitialisé à
    //    "À faire", Équipe conservée, Commentaires vidés ; Predecesseurs/
    //    Jalon_declencheur posés à vide pour l'instant (remappés à l'étape 4,
    //    une fois tous les nouveaux id connus).
    const tacheActions = taches.map(t=>{
      const fin = parseDate(t.Date_fin);
      const offset = offsetOuvresDepuis(DUPLI_ANCRAGE, fin);
      const nouvelleFin = dateDecaleeOuvree(nouvelleAncrage, offset);
      const duree = t.Duree_jours || 1;
      const nouveauDebut = soustraireJoursOuvres(nouvelleFin, duree);
      return ["AddRecord","Taches",null,{
        Section: refId(proj.Section),
        Projet: nouveauProjetId,
        Tache: t.Tache,
        Date_debut: Math.floor(nouveauDebut.getTime()/1000),
        Date_fin: Math.floor(nouvelleFin.getTime()/1000),
        Duree_jours: duree,
        Statut: statutAFaireId,
        Equipe: refId(t.Equipe) || NON_ATTRIBUE_ID,
        Commentaires: "",
        Predecesseurs: ['L'],
        Jalon_declencheur: ['L'],
        Incompressible: t.Incompressible === true
      }];
    });
    const resTaches = tacheActions.length ? await grist.docApi.applyUserActions(tacheActions) : {retValues:[]};
    const mapTaches = {};
    taches.forEach((t,i)=>{ mapTaches[t.id] = resTaches.retValues[i]; });

    // 3. Nouveaux Jalons — Fixe (Important) conservé tel quel ; Taches_requises
    //    posé à vide pour l'instant (remappé à l'étape 4).
    const jalonActions = jalons.map(j=>{
      const d = parseDate(j.Date);
      const offset = offsetOuvresDepuis(DUPLI_ANCRAGE, d);
      const nouvelleDate = dateDecaleeOuvree(nouvelleAncrage, offset);
      return ["AddRecord","Jalons",null,{
        Projet: nouveauProjetId,
        Nom: j.Nom,
        Date: Math.floor(nouvelleDate.getTime()/1000),
        Type: j.Type || null,
        Important: j.Important === true,
        Taches_requises: ['L']
      }];
    });
    const resJalons = jalonActions.length ? await grist.docApi.applyUserActions(jalonActions) : {retValues:[]};
    const mapJalons = {};
    jalons.forEach((j,i)=>{ mapJalons[j.id] = resJalons.retValues[i]; });

    // 4. Remappage des références croisées vers les homologues dupliqués.
    //    Toute référence qui pointerait (anormalement) hors du projet source
    //    est ignorée et comptabilisée — l'interface ne permet pas de créer un
    //    tel lien aujourd'hui, ce garde-fou ne couvre que des données historiques.
    const updateTacheActions = [];
    taches.forEach(t=>{
      const predsMappes = getPredecessorTasks(t).map(p=>refId(p.id||p)).filter(id=>{
        if(!idsTachesSource.has(id)){ refsExternesIgnorees++; return false; }
        return true;
      }).map(id=>mapTaches[id]).filter(Boolean);

      const jalonsMappes = getTacheJalonsDeclencheurs(t).map(j=>j.id).filter(id=>{
        if(!idsJalonsSource.has(id)){ refsExternesIgnorees++; return false; }
        return true;
      }).map(id=>mapJalons[id]).filter(Boolean);

      if(predsMappes.length || jalonsMappes.length){
        updateTacheActions.push(["UpdateRecord","Taches",mapTaches[t.id],{
          Predecesseurs: ['L', ...predsMappes],
          Jalon_declencheur: ['L', ...jalonsMappes]
        }]);
      }
    });
    if(updateTacheActions.length) await grist.docApi.applyUserActions(updateTacheActions);

    const updateJalonActions = [];
    jalons.forEach(j=>{
      const requisesMappees = getJalonTachesRequises(j).map(t=>t.id).filter(id=>{
        if(!idsTachesSource.has(id)){ refsExternesIgnorees++; return false; }
        return true;
      }).map(id=>mapTaches[id]).filter(Boolean);
      if(requisesMappees.length){
        updateJalonActions.push(["UpdateRecord","Jalons",mapJalons[j.id],{
          Taches_requises: ['L', ...requisesMappees]
        }]);
      }
    });
    if(updateJalonActions.length) await grist.docApi.applyUserActions(updateJalonActions);

    // 5. Sous-Actions (table ACTIONS) — rattachées aux nouvelles tâches,
    //    Statut réinitialisé, Commentaires vidés, Équipe conservée.
    const actionsActions = [];
    taches.forEach(t=>{
      getActionsTache(t.id).forEach(a=>{
        actionsActions.push(["AddRecord","ACTIONS",null,{
          Tache: mapTaches[t.id],
          Nom: a.Nom,
          Ordre: a.Ordre || 0,
          Statut: statutAFaireId,
          Equipe: refId(a.Equipe) || null,
          Commentaires: ""
        }]);
      });
    });
    if(actionsActions.length) await grist.docApi.applyUserActions(actionsActions);

    await init();
    construire();
    closeModal("modal-dupliquer-projet");

    let msg = `✅ Projet dupliqué : "${nouveauNom}" (${taches.length} tâche(s), ${jalons.length} jalon(s), ${actionsActions.length} sous-action(s)).`;
    if(refsExternesIgnorees > 0){
      msg += `\n⚠️ ${refsExternesIgnorees} référence(s) pointant hors du projet source ont été ignorées.`;
    }
    alert(msg);
  }catch(e){
    alert("Erreur lors de la duplication : "+e.message);
    console.error(e);
  }finally{
    DUPLI_EN_COURS = false;
    btn.disabled = false;
    btn.textContent = "Dupliquer";
  }
}

