  const fin=document.getElementById("field-tache-fin").value;
  const equipe=document.getElementById("field-tache-equipe").value;
  const statut=document.getElementById("field-tache-statut").value;
  const comments=document.getElementById("field-tache-comments").value.trim();
  const incompressible=document.getElementById("field-tache-incompressible").checked;
  if(!nom || !debut || !fin){ alert("Champs obligatoires manquants (nom, date début, date fin)"); return; }
  if(new Date(fin) < new Date(debut)){
    alert("❌ La date de fin ne peut pas être antérieure à la date de début.");
    return;
  }
  const duree=joursOuvres(new Date(debut), new Date(fin));
  try{
    const proj=DB.projets.find(c=>c.id===projet_id);
    if(!proj){ alert("Projet non trouvé"); return; }
    const statutId=findParamId("Statut", statut);
    const equipeId=findAgentId(equipe) || NON_ATTRIBUE_ID;
    const sectionId = refId(proj.Section);
    if(!sectionId){ alert("Section invalide"); return; }
    const checkboxes = document.querySelectorAll("#field-tache-predecesseurs input[type='checkbox']:checked");
    const predecessorIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    if(id){
      const currentTaskId = parseInt(id);
      for(const predId of predecessorIds){
        if(isDescendant(currentTaskId, predId)){
          alert("❌ Cycle détecté : cette dépendance créerait une boucle. Sélection annulée.");
          return;
        }
      }
    }
    const checkboxesJalons = document.querySelectorAll("#field-tache-jalons-declencheurs input[type='checkbox']:checked");
    const jalonDeclencheurIds = Array.from(checkboxesJalons).map(cb => parseInt(cb.value));
    if(id){
      const currentTaskId = parseInt(id);
      for(const jalonId of jalonDeclencheurIds){
        if(isDescendantUnifie('T:'+currentTaskId, 'J:'+jalonId)){
          alert("❌ Cycle détecté : ce livrable déclencheur créerait une boucle. Sélection annulée.");
          return;
        }
      }
    }
    // Ancienne date de fin (avant modification) pour détecter un changement
    const ancienneTache = id ? DB.taches.find(t=>t.id===parseInt(id)) : null;
    const nouvelleDateFin = Math.floor(new Date(fin).getTime()/1000);
    const dateFinChangee = ancienneTache && ancienneTache.Date_fin !== nouvelleDateFin;

    const values={
      Section:sectionId, Projet:projet_id, Tache:nom,
      Date_debut:Math.floor(new Date(debut).getTime()/1000),
      Date_fin: nouvelleDateFin,
      Duree_jours:duree, Statut:statutId, Equipe:equipeId,
      Commentaires:comments, Predecesseurs:['L',...predecessorIds],
      Jalon_declencheur:['L',...jalonDeclencheurIds],
      Incompressible: incompressible
    };
    if(id){
      await grist.docApi.applyUserActions([["UpdateRecord","Taches",parseInt(id),values]]);
    }else{
      await grist.docApi.applyUserActions([["AddRecord","Taches",null,values]]);
    }
    await init();
    construire();
    // Cascade automatique si Date_fin a changé (édition uniquement)
    if(dateFinChangee && ancienneTache){
      const tacheMisAJour = DB.taches.find(t=>t.id===parseInt(id));
      if(tacheMisAJour){
        const impacts = calculerCascadeDepuisTache(tacheMisAJour);
        if(impacts.length > 0){
          // Conserver l'état AVANT modif pour permettre un vrai "Annuler"
          LAST_CASCADE_ANCIEN_ETAT = {
            genre: "tache",
            id: ancienneTache.id,
            valeurs: {
              Section: ancienneTache.Section,
              Projet: ancienneTache.Projet,
              Tache: ancienneTache.Tache,
              Date_debut: ancienneTache.Date_debut,
              Date_fin: ancienneTache.Date_fin,
              Duree_jours: ancienneTache.Duree_jours,
              Statut: ancienneTache.Statut,
              Equipe: ancienneTache.Equipe,
              Commentaires: ancienneTache.Commentaires,
              Predecesseurs: ancienneTache.Predecesseurs,
              Jalon_declencheur: ancienneTache.Jalon_declencheur,
              Incompressible: ancienneTache.Incompressible,
            }
          };
          afficherRecapCascade("tache", tacheMisAJour.Tache, impacts);
          return; // modale cascade gère la fermeture
        }
      }
    }
    closeModal("modal-tache");
  }catch(e){ alert("Erreur: "+e.message); console.error(e); }
}

async function deleteTache(){
  const id=parseInt(document.getElementById("field-tache-id").value);
  if(!id) return;
  const actionsLiees = getActionsTache(id);
  const msg = actionsLiees.length
    ? `Supprimer cette tâche et ses ${actionsLiees.length} sous-action(s) ?`
    : "Supprimer cette tâche ?";
  if(!confirm(msg)) return;
  try{
    // Les sous-actions doivent partir avec la tâche, sinon elles subsistent
    // en base sans parent visible (lignes orphelines dans ACTIONS).
    const actions = actionsLiees.map(a=>["RemoveRecord","ACTIONS",a.id]);
    actions.push(["RemoveRecord","Taches",id]);
    await grist.docApi.applyUserActions(actions);
    closeModal("modal-tache");
    await init();
    construire();
  }catch(e){ alert("Erreur: "+e.message); console.error(e); }
}

// ============================================================================
// MOTEUR DE CASCADE — déclenché automatiquement à l'enregistrement
// ============================================================================
// Règles :
//   Tâche compressible  → absorbe le retard (Date_fin stable, durée réduite min 1j).
//                         Si pas absorbable (durée < 1j), décalée entièrement.
//   Tâche incompressible → décalée entièrement (durée préservée).
//   Jalon non-fixe      → décalé (comme une tâche incompressible).
//   Jalon fixe          → ne bouge JAMAIS, signalé "En retard".
// La cascade s'arrête sur une tâche qui absorbe (date_fin inchangée → successeurs non touchés).

let LAST_CASCADE_IMPACTS = [];
let LAST_CASCADE_SOURCE  = null; // { type:"tache"|"jalon", modal:"modal-tache"|"modal-jalon" }
// État de la tâche/du jalon AVANT la modification qui a déclenché la popup de
// cascade — capturé pour permettre un vrai "Annuler" (revenir en arrière),
// distinct de "Confirmer" (garder la modif + propager si besoin).
let LAST_CASCADE_ANCIEN_ETAT = null; // { genre:"tache"|"jalon", id, valeurs:{...} }

// ─── Cascade depuis une tâche ─────────────────────────────────────────────
function calculerCascadeDepuisTache(startTask){
  const projId = refId(startTask.Projet);
  const tasksScope = DB.taches.filter(t=>refId(t.Projet)===projId);
  const jalonsScope = DB.jalons.filter(j=>refId(j.Projet)===projId);
  const byTaskId = {};
  tasksScope.forEach(t=>byTaskId[t.id]=t);

  const impacts = [];
  const finEffective = {};   // task.id → Date effective après cascade
  finEffective[startTask.id] = parseDate(startTask.Date_fin);

  const visites = new Set([`T:${startTask.id}`]);
  const file    = [`T:${startTask.id}`];

  while(file.length){
    const key = file.shift();
    const [kind, rawId] = key.split(":");
    const currentId = parseInt(rawId);

    if(kind === "T"){
      // Successeurs tâches (via Predecesseurs)
      tasksScope
        .filter(t=>getPredecessorTasks(t).some(p=>{const pid=refId(p.id||p); return pid===currentId;}))
        .forEach(s=>{ if(!visites.has(`T:${s.id}`)) traiterSuccesseurTache(s); });

      // Successeurs jalons (via Taches_requises)
      jalonsScope
        .filter(j=>norm(getJalonTypeTexte(j))===norm("Livrable"))
        .filter(j=>getJalonTachesRequises(j).some(t=>t.id===currentId))
        .forEach(j=>{ if(!visites.has(`J:${j.id}`)) traiterSuccesseurJalon(j, currentId); });
    }
    // (jalons non-fixe peuvent aussi avoir des successeurs tâches via Jalon_declencheur,
    // mais on ne propage pas au-delà pour garder la popup lisible)
  }

  function traiterSuccesseurTache(s){
    visites.add(`T:${s.id}`);
    // Date de début minimale = fin effective du prédécesseur le plus tardif
    const predsIds = getPredecessorTasks(s).map(p=>refId(p.id||p)).filter(pid=>byTaskId[pid]);
    let maxFin = null;
    predsIds.forEach(pid=>{
      const f = finEffective[pid] !== undefined ? finEffective[pid] : parseDate(byTaskId[pid].Date_fin);
      if(f && (!maxFin || f>maxFin)) maxFin = f;
    });
    if(!maxFin){ finEffective[s.id]=parseDate(s.Date_fin); file.push(`T:${s.id}`); return; }

    const debutMini   = jourOuvreSuivant(maxFin);
    const debutActuel = parseDate(s.Date_debut);
    if(!debutActuel || debutMini <= debutActuel){
      finEffective[s.id]=parseDate(s.Date_fin); file.push(`T:${s.id}`); return;
    }

    const deltaJours = joursOuvres(debutActuel, debutMini) - 1;
    const dureeActuelle = s.Duree_jours || joursOuvres(parseDate(s.Date_debut), parseDate(s.Date_fin));
    const incompressible = s.Incompressible === true;

    if(!incompressible){
      // Tâche compressible : on essaie de garder Date_fin, on réduit la durée
      const nouvelleDuree = dureeActuelle - deltaJours;
      if(nouvelleDuree >= 1){
        // Absorption complète : Date_fin ne change pas, cascade s'arrête ici
        finEffective[s.id] = parseDate(s.Date_fin);
        impacts.push({
          genre:"tache", element:s, nom:s.Tache,
          statut:"absorbe", deltaJours,
          oldDebut:debutActuel, oldFin:parseDate(s.Date_fin),
          newDebut:debutMini,   newFin:parseDate(s.Date_fin),
          nouvelleDuree
        });
        return; // point d'arrêt
      }
    }
    // Décalage entier (incompressible ou compressible qui ne peut pas absorber)
    const nouvelleFin = ajouterJoursOuvres(debutMini, dureeActuelle);
    finEffective[s.id] = nouvelleFin;
    impacts.push({
      genre:"tache", element:s, nom:s.Tache,
      statut:"shift", deltaJours,
      oldDebut:debutActuel, oldFin:parseDate(s.Date_fin),
      newDebut:debutMini,   newFin:nouvelleFin,
      nouvelleDuree:dureeActuelle
    });
    file.push(`T:${s.id}`);
  }

  function traiterSuccesseurJalon(j, sourceTacheId){
    visites.add(`J:${j.id}`);
    const jalonFixe = j.Important === true;
    const dateJalon = parseDate(j.Date);
    // Date de fin effective de la TÂCHE REQUISE qui atteint ce jalon — et non
    // celle de la tâche à l'origine de la cascade : sur une chaîne A→B→C, le
    // jalon conditionné par C doit être comparé à la fin recalculée de C.
    const dateFinSource = finEffective[sourceTacheId] !== undefined
      ? finEffective[sourceTacheId]
      : parseDate((byTaskId[sourceTacheId]||{}).Date_fin);
    if(!dateJalon || !dateFinSource){ return; }
    if(dateFinSource <= dateJalon){ return; } // pas de dépassement

    const deltaJours = joursOuvres(dateJalon, dateFinSource);
    if(jalonFixe){
      impacts.push({
        genre:"jalon", element:j, nom:j.Nom,
        statut:"fixe", deltaJours,
        oldFin:dateJalon, newFin:dateJalon
      });
    } else {
      const nouvelleDate = ajouterJoursOuvres(dateFinSource, 1);
      impacts.push({
        genre:"jalon", element:j, nom:j.Nom,
        statut:"shift", deltaJours,
        oldFin:dateJalon, newFin:nouvelleDate
      });
    }
  }

  // ─── Conflits amont : jalons qui attendent cette tâche et que la nouvelle
  // Date_fin dépasse maintenant (quel que soit leur caractère Fixe ou non).
  const nouvelleDateFinSource = parseDate(startTask.Date_fin);
  jalonsScope
    .filter(j => norm(getJalonTypeTexte(j)) === norm("Livrable"))
    .filter(j => getJalonTachesRequises(j).some(t => t.id === startTask.id))
    .forEach(j => {
      const dateJalon = parseDate(j.Date);
      if(!dateJalon || !nouvelleDateFinSource) return;
      if(nouvelleDateFinSource <= dateJalon) return; // pas de dépassement
      const deltaJours = joursOuvres(dateJalon, nouvelleDateFinSource);
      impacts.push({
        genre:"jalon", element:j, nom:j.Nom,
        statut:"conflit", deltaJours,
        detail:`Tâche finit le ${fmtJourComplet(Math.floor(nouvelleDateFinSource.getTime()/1000))} > Jalon le ${fmtJourComplet(Math.floor(dateJalon.getTime()/1000))}`
      });
    });

  return impacts;
}
function calculerCascadeDepuisJalon(jalon){
  const projId = refId(jalon.Projet);
  const tasksScope = DB.taches.filter(t=>refId(t.Projet)===projId);
  const impacts = [];
  const nouvelleDateJalon = parseDate(jalon.Date);
  if(!nouvelleDateJalon) return impacts;

  // ─── Cascades vers l'avant : tâches déclenchées par ce jalon
  tasksScope
    .filter(t=>getTacheJalonsDeclencheurs(t).some(j=>j.id===jalon.id))
    .forEach(t=>{
      const debutActuel = parseDate(t.Date_debut);
      if(!debutActuel || nouvelleDateJalon <= debutActuel) return;
      const deltaJours = joursOuvres(debutActuel, nouvelleDateJalon);
      const debutMini = jourOuvreSuivant(nouvelleDateJalon);
      const duree = t.Duree_jours || 1;
      const nouvelleFin = ajouterJoursOuvres(debutMini, duree);
      impacts.push({
        genre:"tache", element:t, nom:t.Tache,
        statut:"shift", deltaJours,
        oldDebut:debutActuel, oldFin:parseDate(t.Date_fin),
        newDebut:debutMini,   newFin:nouvelleFin,
        nouvelleDuree:duree
      });
    });

  // ─── Conflits amont : tâches requises dont la Date_fin dépasse la nouvelle date du jalon
  getJalonTachesRequises(jalon).forEach(t=>{
    const finTache = parseDate(t.Date_fin);
    if(!finTache || finTache <= nouvelleDateJalon) return;
    const deltaJours = joursOuvres(nouvelleDateJalon, finTache);
    impacts.push({
      genre:"tache", element:t, nom:t.Tache,
      statut:"conflit", deltaJours,
      detail:`Finit le ${fmtJourComplet(Math.floor(finTache.getTime()/1000))} > Jalon avancé au ${fmtJourComplet(Math.floor(nouvelleDateJalon.getTime()/1000))}`
    });
  });

  return impacts;
}

// ─── Affichage de la popup (unifiée tâche + jalon) ──────────────────────────
function afficherRecapCascade(sourceType, sourceNom, impacts){
  LAST_CASCADE_IMPACTS = impacts;
  LAST_CASCADE_SOURCE  = { type:sourceType, modal: sourceType==="tache" ? "modal-tache" : "modal-jalon" };

  const recapDiv = document.getElementById("cascade-recap");
  recapDiv.innerHTML = "";

  const conflits = impacts.filter(i=>i.statut==="conflit");
  const cascades = impacts.filter(i=>i.statut!=="conflit");
  // "nbAAppliquer" détermine s'il y a des écritures supplémentaires à faire
  // en cas de clic sur "Confirmer" (décalages, absorptions). Le bouton reste
  // désormais TOUJOURS visible, même à 0 — comportement cohérent : "Confirmer"
  // garde la modification (et propage si besoin), "Annuler" revient en arrière.
  // Avant ce correctif, "Confirmer" disparaissait s'il n'y avait que des
  // conflits (rien à propager), ne laissant que "Annuler" — qui, lui, ne
  // faisait alors QUE fermer la popup sans rien annuler de réel : source de
  // confusion (voir LAST_CASCADE_ANCIEN_ETAT plus bas pour le vrai "Annuler").
  const nbAAppliquer = cascades.filter(i=>i.statut==="shift" || i.statut==="absorbe").length;

  document.getElementById("cascade-titre").textContent =
    [conflits.length>0 ? `${conflits.length} conflit(s)` : "",
     cascades.length>0 ? `${cascades.length} impact(s) à propager` : ""]
    .filter(Boolean).join(" · ") || "Impacts calendaires";

  document.getElementById("btn-confirmer-cascade").style.display = "inline-block";

  // ── Section conflits (informationnelle, pas d'action automatique) ──────────
  if(conflits.length>0){
    const titre = document.createElement("div");
    titre.style.cssText = "font-size:11px;font-weight:700;color:var(--critique);text-transform:uppercase;letter-spacing:.5px;margin:4px 0 6px 0;";
    titre.textContent = "⚠️ Conflits détectés";
    recapDiv.appendChild(titre);

    conflits.forEach(impact=>{
      const ligne = document.createElement("div");
      ligne.className = "cascade-recap-line";
      ligne.style.background = "#FFF5F5";

      const icone = document.createElement("span");
      icone.textContent = impact.genre==="jalon" ? "◆" : "▶";
      icone.style.cssText = "font-size:10px;flex-shrink:0;color:var(--critique)";
      ligne.appendChild(icone);

      const nom = document.createElement("span");
      nom.className = "nom-element";
      nom.textContent = impact.nom;
      ligne.appendChild(nom);

      const detail = document.createElement("span");
      detail.className = "dates-shift";
      detail.textContent = impact.detail || "";
      ligne.appendChild(detail);

      const badge = document.createElement("span");
      badge.className = "badge conflit";
      badge.textContent = "Conflit";
      badge.style.background = "var(--critique)";
      ligne.appendChild(badge);

      recapDiv.appendChild(ligne);
    });

    if(cascades.length>0){
      const sep = document.createElement("div");
      sep.style.cssText = "border-top:1px solid var(--bordure);margin:10px 0 6px 0;";
      recapDiv.appendChild(sep);
    }
  }

  // ── Section cascades (décalages et absorptions) ────────────────────────────
  if(cascades.length>0){
    const titre = document.createElement("div");
    titre.style.cssText = "font-size:11px;font-weight:700;color:var(--texte-mention);text-transform:uppercase;letter-spacing:.5px;margin:4px 0 6px 0;";
    titre.textContent = "Propagation";
    recapDiv.appendChild(titre);

    cascades.forEach(impact=>{
      const ligne = document.createElement("div");
      ligne.className = "cascade-recap-line" + (impact.statut!=="shift" ? " dim" : "");

      const icone = document.createElement("span");
      icone.textContent = impact.genre==="jalon" ? "◆" : "▶";
      icone.style.cssText = "font-size:10px;opacity:0.6;flex-shrink:0";
      ligne.appendChild(icone);

      const nom = document.createElement("span");
      nom.className = "nom-element";
      nom.textContent = impact.nom;
      ligne.appendChild(nom);

      const dates = document.createElement("span");
      dates.className = "dates-shift";
      if(impact.statut==="shift"){
        const oldD = impact.oldDebut || impact.oldFin;
        const newD = impact.newDebut || impact.newFin;
        if(oldD && newD)
          dates.textContent = `${fmtJourComplet(Math.floor(oldD.getTime()/1000))} → ${fmtJourComplet(Math.floor(newD.getTime()/1000))}`;
      } else if(impact.statut==="absorbe"){
        dates.textContent = `durée réduite à ${impact.nouvelleDuree}j`;
      } else if(impact.statut==="fixe"){
        dates.textContent = `reste au ${fmtJourComplet(Math.floor(impact.oldFin.getTime()/1000))}`;
      }
      ligne.appendChild(dates);

      const badge = document.createElement("span");
      badge.className = "badge " + impact.statut;
      badge.textContent = impact.statut==="shift" ? "Décalé"
        : impact.statut==="absorbe" ? "Absorbé"
        : "Fixe";
      ligne.appendChild(badge);

      recapDiv.appendChild(ligne);
    });
  }

  openModal("modal-cascade");
}

// "Annuler" = revient réellement en arrière : la tâche/le jalon retrouve sa
// valeur d'avant la modification (nouvelle écriture Grist), et rien n'est
// propagé. Avant ce correctif, ce bouton fermait juste la popup sans rien
// annuler — la modification restait silencieusement enregistrée, ce qui
// prêtait à confusion (l'intitulé "Annuler" laissait croire le contraire).
async function annulerCascade(){
  const etatAnterieur = LAST_CASCADE_ANCIEN_ETAT;
  closeModal("modal-cascade");
  if(LAST_CASCADE_SOURCE) closeModal(LAST_CASCADE_SOURCE.modal);
  LAST_CASCADE_IMPACTS = [];
  LAST_CASCADE_SOURCE  = null;
  LAST_CASCADE_ANCIEN_ETAT = null;

  if(etatAnterieur){
    try{
      const table = etatAnterieur.genre === "tache" ? "Taches" : "Jalons";
      await grist.docApi.applyUserActions([["UpdateRecord", table, etatAnterieur.id, etatAnterieur.valeurs]]);
      await init();
      construire();
    }catch(e){
      alert("Erreur lors de l'annulation : "+e.message);
      console.error(e);
    }
  }
}

// "Confirmer" (= OK) : garde la modification telle quelle, et applique en
// plus les décalages en cascade s'il y en a. S'il n'y a rien à propager
// (cas "conflits uniquement"), se contente de fermer — pas d'appel réseau
// inutile.
async function confirmerCascade(){
  const aAppliquer = LAST_CASCADE_IMPACTS.filter(i=>i.statut==="shift");
  try{
    const tachesActions = aAppliquer
      .filter(i=>i.genre==="tache")
      .map(i=>["UpdateRecord","Taches",i.element.id,{
        Date_debut: Math.floor(i.newDebut.getTime()/1000),
        Date_fin:   Math.floor(i.newFin.getTime()/1000)
        // Duree_jours inchangée : cascade décale, ne rallonge/raccourcit pas
      }]);
    const jalonsActions = aAppliquer
      .filter(i=>i.genre==="jalon")
      .map(i=>["UpdateRecord","Jalons",i.element.id,{
        Date: Math.floor(i.newFin.getTime()/1000)
      }]);
    const absorbeActions = LAST_CASCADE_IMPACTS
      .filter(i=>i.statut==="absorbe")
      .map(i=>["UpdateRecord","Taches",i.element.id,{
        Date_debut: Math.floor(i.newDebut.getTime()/1000),
        // Date_fin inchangée, on met juste à jour la durée
        Duree_jours: i.nouvelleDuree
      }]);
    const toutesLesActions = [...tachesActions,...jalonsActions,...absorbeActions];
    if(toutesLesActions.length > 0){
      await grist.docApi.applyUserActions(toutesLesActions);
      await init();
      construire();
    }
    closeModal("modal-cascade");
    if(LAST_CASCADE_SOURCE) closeModal(LAST_CASCADE_SOURCE.modal);
  }catch(e){ alert("Erreur lors de la cascade : "+e.message); console.error(e); }
  LAST_CASCADE_IMPACTS=[];
  LAST_CASCADE_SOURCE=null;
  LAST_CASCADE_ANCIEN_ETAT=null;
}

// Mesure précise de la largeur d'un texte avec la police réelle du widget.
// "font" est optionnel : par défaut la police des labels de jalons (700 10px),
// mais peut être surchargée (ex: police des noms de tâche dans les barres, 400 11px).
let _canvasCtx = null;
const FONT_JALON = '700 10px "Marianne", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif';
const FONT_BARRE_TACHE = '400 11px "Marianne", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif';
function mesurerLargeurTexte(texte, font){
  if(!_canvasCtx){
    const canvas = document.createElement("canvas");
    _canvasCtx = canvas.getContext("2d");
  }
  _canvasCtx.font = font || FONT_JALON;
  return _canvasCtx.measureText(texte).width;
}

// Calcule le niveau vertical de chaque jalon pour éviter les chevauchements de texte
const JALON_TOP_BASE = 10;
const JALON_NIVEAU_ESPACEMENT = 18;
const JALON_TEXTE_OFFSET = 22;  // doit correspondre au "left" CSS de .jalon-name
const JALON_MARGE = 10;

function calculerNiveauxJalons(jalonsProj, minI){
  const finOccupeeParNiveau = [];
  jalonsProj.forEach(item=>{
    const xDiamant = (item.dIdx - minI + 1) * JOUR_PX;
    const xDebutTexte = xDiamant - 6;  // le diamant déborde à gauche
    const xFinTexte = xDiamant + JALON_TEXTE_OFFSET + mesurerLargeurTexte(item.jalon.Nom);
    let niveau = 0;
    while(finOccupeeParNiveau[niveau] !== undefined && xDebutTexte < finOccupeeParNiveau[niveau] + JALON_MARGE){
      niveau++;
    }
    finOccupeeParNiveau[niveau] = xFinTexte;
    item.niveau = niveau;
  });
  const nbNiveaux = finOccupeeParNiveau.length || 1;
  return nbNiveaux;
}

function construire(){
  RETARDS_STRUCTURELS = calculerRetardsStructurels();
  const allDates = [];
  // La plage de dates (donc toute l'échelle horizontale du Gantt) se base sur
  // TOUTES les tâches/jalons, projets repliés inclus. Plier/déplier un projet
  // est une action verticale (masquer des lignes) : ça ne doit jamais décaler
  // le repère "jour zéro" ni la position de la ligne/bouton "Aujourd'hui".
  DB.taches.forEach(t => {
    const dIdx = dayIndex(t.Date_debut);
    if(dIdx !== null) {
      allDates.push(dIdx);
      const finIdx = dayIndex(t.Date_fin);
      allDates.push(finIdx !== null ? finIdx : dIdx + (t.Duree_jours || 1) - 1);
    }
  });
  DB.jalons.forEach(j => {
    const dIdx = dayIndex(j.Date);
    if(dIdx !== null) allDates.push(dIdx);
  });
  let minI, maxI;
  if(allDates.length > 0){
    minI = Math.min(...allDates);
    maxI = Math.max(...allDates);
  } else {
    const today = Math.floor(Date.now()/86400000);
    minI = today - 14;
    maxI = today + 21;
  }
  // Toujours inclure "aujourd'hui" (+ petite marge) dans la plage affichée, même si
  // aucune tâche/jalon ne s'y trouve : sinon le marqueur "Aujourd'hui" et le bouton
  // 📍 Aujourd'hui n'ont aucun jour valide vers lequel se centrer.
  const todayIdx = Math.floor(Date.now()/86400000);
  minI = Math.min(minI, todayIdx - 3);
  maxI = Math.max(maxI, todayIdx + 3);
  const jourSemaineMinI = new Date(minI*86400000).getUTCDay();
  const decalageLundi = (jourSemaineMinI + 6) % 7;
  const minILundi = minI - decalageLundi;
  minI = minILundi;
  const totalJours=maxI-minI+1;
  const tlW=totalJours*JOUR_PX;
  const todayI=Math.floor(Date.now()/86400000);
  const todayOffset=todayI-minI;
  allData={minI, maxI, todayI, todayOffset, totalJours, tlW};
  const labelsDiv=document.getElementById("labels");
  const grid=document.createElement("div");
  grid.className="grid";
  grid.style.setProperty("--tl-w", tlW+"px");
  grid.style.setProperty("--today", todayOffset);
  labelsDiv.innerHTML="";
  const NOMS_JOURS=['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  const head=el("div","head-track");
  const headInner=el("div","head-inner");
  for(let i=minILundi;i<=maxI;i+=7){
    const wn=getWeekNumber(new Date(i*86400000));
    const label=el("div","week-label");
    const semaineLargeur = 7 * JOUR_PX;
    label.style.left=((i-minI)*JOUR_PX)+"px";
    label.style.width=semaineLargeur+"px";
    const start=fmtJJMM(i), end=fmtJJMM(i+4);
    const jourDebut=NOMS_JOURS[new Date(i*86400000).getUTCDay()];
    const jourFin=NOMS_JOURS[new Date((i+4)*86400000).getUTCDay()];
    if(semaineLargeur >= 60){
      label.innerHTML=`<div class="week-num">S${wn}</div><div class="week-date">${start}<br>${end}</div>`;
    } else if(semaineLargeur >= 22){
      label.innerHTML=`<div class="week-num">S${wn}</div>`;
    }
    label.setAttribute("data-tooltip",`du ${jourDebut.charAt(0).toUpperCase()+jourDebut.slice(1)} ${start} au ${jourFin.charAt(0).toUpperCase()+jourFin.slice(1)} ${end}\\n(5 j. ouvrés)`);
    headInner.appendChild(label);
  }
  head.appendChild(headInner);
  grid.appendChild(head);
  
  // Appliquer les filtres Section et Projet
  let projetsAffichage = obtenirProjetsAffiches();
  
  projetsAffichage.forEach(proj=>{
    // 1. Calcul des jalons et de leurs niveaux AVANT de créer le bandeau
    const jalonsProj = DB.jalons
      .filter(j=>refId(j.Projet)===proj.id)
      .map(j=>({ jalon:j, dIdx:dayIndex(j.Date) }))
      .filter(x=>x.dIdx!==null && x.dIdx>=minI && x.dIdx<=maxI)
      .sort((a,b)=>a.dIdx-b.dIdx);
    const nbNiveaux = calculerNiveauxJalons(jalonsProj, minI);

    // 2. Hauteur dynamique du bandeau projet
    const PROJ_H = Math.max(46, JALON_TOP_BASE + (nbNiveaux - 1) * JALON_NIVEAU_ESPACEMENT + 26);

    const projGroup=el("div","proj-group");
    if(COLLAPSED_PROJETS.has(proj.id)) projGroup.classList.add("collapsed");
    const labProj=el("div","label projet");
    labProj.style.height = PROJ_H + "px";
    const btnCollapse=el("button","btn-collapse");
    btnCollapse.textContent="▼";
    btnCollapse.onclick=(e)=>{ e.stopPropagation(); toggleProjetCollapse(proj.id); };
    labProj.appendChild(btnCollapse);
    const nomSpan=el("span","nom-projet",proj.Projet);
    nomSpan.onclick=(e)=>{ e.stopPropagation(); openProjetEdit(proj); };
    labProj.appendChild(nomSpan);
    const actions=el("div","label-actions");
    const btnJalon=el("button","btn-tiny add"); btnJalon.textContent="🚩";
    btnJalon.onclick=()=>{ openJalonCreate(proj.id); };
    const btnTache=el("button","btn-tiny add"); btnTache.textContent="+";
    btnTache.onclick=()=>{ openTacheCreate(proj.id); };
    const btnDupliquer=el("button","btn-tiny"); btnDupliquer.textContent="⧉";
    btnDupliquer.title="Dupliquer ce projet";
    btnDupliquer.onclick=(e)=>{ e.stopPropagation(); openDupliquerProjet(proj.id); };
    actions.appendChild(btnJalon); actions.appendChild(btnTache); actions.appendChild(btnDupliquer);
    labProj.appendChild(actions);
    labelsDiv.appendChild(labProj);
    const trackProj=el("div","track projet");
    trackProj.style.height = PROJ_H + "px";
    projGroup.appendChild(trackProj);
    const tachesProj = DB.taches.filter(t=>refId(t.Projet)===proj.id).sort((a, b) => {
      const dateA = dayIndex(a.Date_debut) || Infinity;
      const dateB = dayIndex(b.Date_debut) || Infinity;
      return dateA - dateB;
    });
    const taskPositions = {};
    tachesProj.forEach((t, idx)=>{
      const statutTexte=resolveRef(DB.parametres, t.Statut, "Statut");
      const equipeTexte=resolveRef(DB.parametres, t.Equipe, "Equipe");
      const labTask=el("div","label tache");
      labTask.setAttribute("data-projet", proj.id);
      if(COLLAPSED_PROJETS.has(proj.id)) labTask.classList.add("hidden");
      const nomSpanTache = el("span","nom",t.Tache);
      nomSpanTache.onclick=(e)=>{ e.stopPropagation(); openTacheEdit(t); };
      labTask.appendChild(nomSpanTache);
      // Retard structurel : cette tâche en provoque un (⚠️→) ou le subit (🔴)
      const retardT = getRetardStructurel("tache", t.id);
      if(retardT.provoque.length>0){
        const icoProvoque = el("span","retard-icone provoque","⚠️");
        icoProvoque.title = "Met en retard : " + retardT.provoque.map(x=>x.nom).join(", ");
        labTask.appendChild(icoProvoque);
      }
      if(retardT.subit.length>0){
        const icoSubit = el("span","retard-icone subit","🔴");
        icoSubit.title = "En retard (bloquée par " + retardT.subit.join(", ") + ")";
        labTask.appendChild(icoSubit);
      }
      if(equipeTexte) labTask.appendChild(el("span","equipe",equipeTexte));
      labelsDiv.appendChild(labTask);
      const track=el("div","track tache");
      const dIdx=dayIndex(t.Date_debut);
      if(dIdx!==null){
        if(dIdx<=maxI){
          const info=statutInfo(statutTexte);
          const barre=el("div","barre "+info.cls);
          if(t.Date_fin && parseDate(t.Date_fin) < new Date() && norm(statutTexte)!==norm("Terminé")) barre.classList.add("critique");
          barre.style.left=((dIdx-minI)*JOUR_PX)+"px";
          const finIdx = dayIndex(t.Date_fin);
          const duree = t.Duree_jours || 1;
          const finIdxReel = finIdx !== null ? finIdx : (dIdx + duree - 1);
          const etalementJours = finIdxReel - dIdx + 1;
          const largeurBarrePx = Math.max(1,etalementJours*JOUR_PX);
          barre.style.width=largeurBarrePx+"px";
          barre.style.background=cssVarValue(info.couleur);
          // Si le nom ne rentre pas dans la barre (padding 6px de chaque côté),
          // on l'affiche À CÔTÉ plutôt que de le laisser tronqué/illisible —
          // même principe que les labels de jalons, qui ont ce souci résolu
          // depuis longtemps. Si la barre est assez large, rien ne change.
          const largeurTexteDispo = largeurBarrePx - 12;
          const largeurTexteReelle = mesurerLargeurTexte(t.Tache, FONT_BARRE_TACHE);
          if(largeurTexteReelle <= largeurTexteDispo){
            barre.textContent = t.Tache;
          } else {
            const labelExterne = el("div","barre-nom-externe", t.Tache);
            labelExterne.style.left = ((dIdx-minI)*JOUR_PX + largeurBarrePx + 6) + "px";
            labelExterne.onclick = (e)=>{ e.stopPropagation(); openTacheEdit(t); };
            track.appendChild(labelExterne);
          }
          // Bulle de secours dans tous les cas (barre pleine ou label externe) :
          // permet de relire le nom complet au survol, quelle que soit la situation.
          barre.title = t.Commentaires ? (t.Tache+" — "+t.Commentaires) : t.Tache;
          barre.onclick=(e)=>{ e.stopPropagation(); openTacheEdit(t); };
          track.appendChild(barre);
          if(JOUR_PX >= 6){
            const debutLabel = el("div","date-label", fmtJJMM(dIdx));
            debutLabel.style.left = ((dIdx-minI)*JOUR_PX + 8) + "px";
            track.appendChild(debutLabel);
            if(finIdxReel !== dIdx && duree > 2){
              const finLabel = el("div","date-label", fmtJJMM(finIdxReel));
              finLabel.style.left = ((finIdxReel-minI)*JOUR_PX + 8) + "px";
              track.appendChild(finLabel);
            }
          }
          taskPositions[t.id] = {dIdx: dIdx, finIdxReel: finIdxReel, rowIndex: idx};
        }
      }else{
        const pill=el("div","pill-plan","à planifier");
        pill.style.cursor="pointer";
        pill.onclick=(e)=>{ e.stopPropagation(); openTacheEdit(t); };
        track.appendChild(pill);
      }
      projGroup.appendChild(track);
    });
    const ROW_H = 44;
    const BARRE_TOP = 20, BARRE_H = 22;
    function ancrageBarre(pos, cote){
      const gauche = (pos.dIdx - minI) * JOUR_PX;
      const droite = (pos.finIdxReel - minI + 1) * JOUR_PX;
      const centreX = (gauche + droite) / 2;
      const yHautBarre = PROJ_H + pos.rowIndex * ROW_H + BARRE_TOP;
      const yBasBarre = yHautBarre + BARRE_H;
      const yCentreBarre = yHautBarre + BARRE_H / 2;
      switch(cote){
        case "est":   return { x: droite,  y: yCentreBarre };
        case "ouest": return { x: gauche,  y: yCentreBarre };
        case "nord":  return { x: centreX, y: yHautBarre };
        case "sud":   return { x: centreX, y: yBasBarre };
      }
    }
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("class", "dependencies-svg");
    svg.setAttribute("width", tlW);
    svg.setAttribute("height", PROJ_H + tachesProj.length * ROW_H);
    tachesProj.forEach(t=>{
      const taskPos = taskPositions[t.id];
      if(!taskPos) return;
      getPredecessorTasks(t).forEach(pred=>{
        const predId = refId(pred.id||pred);
        const predPos = taskPositions[predId];
        if(!predPos) return;
        const ecart = taskPos.dIdx - predPos.finIdxReel;
        let p1, p2, arriveeCote, path;
        if(ecart > 2){
          p1 = ancrageBarre(predPos, "est");
          p2 = ancrageBarre(taskPos, "ouest");
          arriveeCote = "ouest";
          const midX = (p1.x + p2.x) / 2;
          path = `M ${p1.x} ${p1.y} L ${midX} ${p1.y} L ${midX} ${p2.y} L ${p2.x} ${p2.y}`;
        } else if(ecart >= -1){
          p1 = ancrageBarre(predPos, "sud");
          p2 = ancrageBarre(taskPos, "ouest");
          arriveeCote = "ouest";
          path = `M ${p1.x} ${p1.y} L ${p1.x} ${p2.y} L ${p2.x} ${p2.y}`;
        } else {
          p1 = ancrageBarre(predPos, "sud");
          p2 = ancrageBarre(taskPos, "nord");
          arriveeCote = "nord";
          const midY = (p1.y + p2.y) / 2;
          path = `M ${p1.x} ${p1.y} L ${p1.x} ${midY} L ${p2.x} ${midY} L ${p2.x} ${p2.y}`;
        }
        const statutCible = resolveRef(DB.parametres, t.Statut, "Statut");
        const strokeColor = cssVarValue(statutInfo(statutCible).couleur);
        const pathEl = document.createElementNS("http://www.w3.org/2000/svg", "path");
        pathEl.setAttribute("d", path);
        pathEl.setAttribute("stroke", strokeColor);
        pathEl.setAttribute("stroke-width", "1.5");
        pathEl.setAttribute("fill", "none");
        svg.appendChild(pathEl);
        const angleParCote = { ouest: 0, nord: Math.PI/2, sud: -Math.PI/2 };
        const angle = angleParCote[arriveeCote];
        const arrowSize = 3.5;
        const tipX = p2.x, tipY = p2.y;
        const baseX = tipX - arrowSize * 2 * Math.cos(angle);
        const baseY = tipY - arrowSize * 2 * Math.sin(angle);
        const polygon = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
        polygon.setAttribute("points", `${tipX},${tipY} ${baseX - arrowSize*Math.sin(angle)},${baseY + arrowSize*Math.cos(angle)} ${baseX + arrowSize*Math.sin(angle)},${baseY - arrowSize*Math.cos(angle)}`);
        polygon.setAttribute("fill", strokeColor);
        svg.appendChild(polygon);
      });
    });
    projGroup.appendChild(svg);

    jalonsProj.forEach(({jalon, dIdx, niveau})=>{
        const xDiamant=(dIdx-minI+1)*JOUR_PX;
        const leftPx=xDiamant+"px";
        const topNum=JALON_TOP_BASE + niveau * JALON_NIVEAU_ESPACEMENT;
        const topPx=topNum+"px";
        const typeTexte = getJalonTypeTexte(jalon);
        const couleur=cssVarValue(jalonCouleur(typeTexte, jalon.Important));
        const retardJ = getRetardStructurel("jalon", jalon.id);
        const jalonLine=el("div","jalon-line");
        jalonLine.style.left=leftPx;
        jalonLine.style.top=PROJ_H+"px";
        jalonLine.style.background=couleur;
        projGroup.appendChild(jalonLine);
        const nameEl=el("div","jalon-name");
        const dateStr = fmtDateCourt(jalon.Date) || "??";
        nameEl.textContent = `${dateStr} ${jalon.Nom}`;
        nameEl.style.left=(xDiamant + JALON_TEXTE_OFFSET)+"px";
        nameEl.style.top=topPx;
        nameEl.style.color=couleur;
        nameEl.onclick=(e)=>{ e.stopPropagation(); openJalonEdit(jalon); };
        projGroup.appendChild(nameEl);
        const markerWrap=el("div","jalon-marker-wrap");
        markerWrap.style.left=leftPx;
        markerWrap.style.top=topPx;
        const tooltipRetard = retardJ.subit.length>0 ? `\\nEn retard (bloqué par ${retardJ.subit.join(", ")})` : "";
        markerWrap.setAttribute("data-tooltip", `${jalon.Nom}${typeTexte?` (${typeTexte})`:""}\\n${fmtJourComplet(jalon.Date)}${tooltipRetard}`);
        markerWrap.onclick=(e)=>{ e.stopPropagation(); openJalonEdit(jalon); };
        const diamond=el("div","jalon-marker-diamond"+(retardJ.subit.length>0?" retard-subit":""));
        diamond.style.background=couleur;
        markerWrap.appendChild(diamond);
        projGroup.appendChild(markerWrap);

        // Flèches de dépendance Livrable : tâches requises → jalon, et jalon → tâches déclenchées
        if(norm(typeTexte)===norm("Livrable")){
          const pointJalon = {x: xDiamant, y: topNum};
          getJalonTachesRequises(jalon).forEach(reqTask=>{
            const pos = taskPositions[reqTask.id];
            if(!pos) return;
            const p1 = ancrageBarre(pos, "est");
            if(!p1 || isNaN(p1.x) || isNaN(p1.y) || isNaN(pointJalon.x) || isNaN(pointJalon.y)) return;
            const path = `M ${p1.x} ${p1.y} L ${pointJalon.x} ${p1.y} L ${pointJalon.x} ${pointJalon.y}`;
            const pathEl = document.createElementNS("http://www.w3.org/2000/svg", "path");
            pathEl.setAttribute("d", path);
            pathEl.setAttribute("stroke", couleur);
            pathEl.setAttribute("stroke-width", "1.5");
            pathEl.setAttribute("stroke-dasharray", "3,2");
            pathEl.setAttribute("fill", "none");
            svg.appendChild(pathEl);
          });
          tachesProj.filter(t=>getTacheJalonsDeclencheurs(t).some(j=>j.id===jalon.id)).forEach(declTask=>{
            const pos = taskPositions[declTask.id];
            if(!pos) return;
            const p2 = ancrageBarre(pos, "ouest");
            if(!p2 || isNaN(p2.x) || isNaN(p2.y) || isNaN(pointJalon.x) || isNaN(pointJalon.y)) return;
            const path = `M ${pointJalon.x} ${pointJalon.y} L ${pointJalon.x} ${p2.y} L ${p2.x} ${p2.y}`;
            const pathEl = document.createElementNS("http://www.w3.org/2000/svg", "path");
            pathEl.setAttribute("d", path);
            pathEl.setAttribute("stroke", couleur);
            pathEl.setAttribute("stroke-width", "1.5");
            pathEl.setAttribute("stroke-dasharray", "3,2");
            pathEl.setAttribute("fill", "none");
            svg.appendChild(pathEl);
            const arrowSize = 3.5;
            const polygon = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
            polygon.setAttribute("points", `${p2.x},${p2.y} ${p2.x-arrowSize*2},${p2.y-arrowSize} ${p2.x-arrowSize*2},${p2.y+arrowSize}`);
            polygon.setAttribute("fill", couleur);
            svg.appendChild(polygon);
          });
        }
    });

    grid.appendChild(projGroup);
  });
  document.getElementById("kanban").innerHTML="";
  document.getElementById("kanban").appendChild(grid);
  document.getElementById("meta").textContent=`${DB.projets.length} projet(s) · ${DB.taches.length} tâche(s)`;
  rendreLegende();
  
  // Le recentrage automatique (ZOOM_CENTER_DAY) ne sert qu'à préserver le point
  // de vue lors d'un zoom avant/arrière/reset — ce n'est PAS un scroll "au
  // hasard" à chaque rendu. En dehors du zoom, on ne touche plus au scroll ici :
  // le saut systématique vers aujourd'hui à chaque sauvegarde/édition a été
  // retiré. Le scroll volontaire vers la 1ère date visible se déclenche
  // uniquement à l'ouverture du Gantt et au dépli d'un projet (scrollVersDebutVisible()).
  if(ZOOM_CENTER_DAY !== null){
    setTimeout(()=>{
      const scrollDiv = document.getElementById("timeline-scroll");
      const cible = (ZOOM_CENTER_DAY - minI) * JOUR_PX - Math.max(0, (scrollDiv.clientWidth - LABEL_W)) / 2;
      scrollDiv.scrollLeft = Math.max(0, cible);
      ZOOM_CENTER_DAY = null;
    }, 300);
  }
}

function getWeekNumber(d){
  const date=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()));
  const dayNum=date.getUTCDay()||7;
  date.setUTCDate(date.getUTCDate()+4-dayNum);
  const yearStart=new Date(Date.UTC(date.getUTCFullYear(),0,1));
  return Math.ceil((((date-yearStart)/86400000)+1)/7);
}
function fmtJJMM(idx){
  const d=new Date(idx*86400000);
  return String(d.getUTCDate()).padStart(2,"0")+"/"+String(d.getUTCMonth()+1).padStart(2,"0");
}
function rendreLegende(){
  const l=document.getElementById("legende");
  l.innerHTML="";
  STATUTS.forEach(s=>{
    const item=el("div","item");
    const puce=el("span","puce"); puce.style.background=s.couleur;
    item.appendChild(puce);
    item.appendChild(document.createTextNode(s.nom));
    l.appendChild(item);
  });
  [["Jalon majeur","var(--jalon-majeur)"],["Livrable","var(--jalon-livrable)"],["Pour information","var(--jalon-info)"]].forEach(([label,couleur])=>{
    const item=el("div","item");
    const puce=el("span","puce jalon-puce"); puce.style.background=couleur;
    item.appendChild(puce);
    item.appendChild(document.createTextNode(label));
    l.appendChild(item);
  });
  const itemCrit=el("div","item");
  const puceCrit=el("span","puce critique-puce");
  itemCrit.appendChild(puceCrit);
  itemCrit.appendChild(document.createTextNode("Tâche en retard"));
  l.appendChild(itemCrit);
}
function el(tag,cls,txt){
  const e=document.createElement(cls?"div":tag);
  if(cls)e.className=cls;
  if(txt!==undefined&&txt!==null)e.textContent=txt;
  return e;
}

document.getElementById("btn-add-projet").onclick=()=>openProjetCreate();
document.getElementById("field-jalon-type").addEventListener("change", toggleJalonTachesRequisesVisibilite);
// Calcul en temps réel (input = chaque frappe, pas juste blur)
document.getElementById("field-tache-debut").addEventListener("input", majDepuisDebut);
document.getElementById("field-tache-debut").addEventListener("change", majDepuisDebut);
document.getElementById("field-tache-fin").addEventListener("input", majDepuisFin);
document.getElementById("field-tache-fin").addEventListener("change", majDepuisFin);
document.getElementById("field-tache-duree").addEventListener("input", majDepuisDuree);
document.getElementById("field-tache-duree").addEventListener("change", majDepuisDuree);
document.getElementById("btn-add-action").addEventListener("click", (e) => {
  e.preventDefault();
  const tacheId = parseInt(document.getElementById("field-tache-id").value);
  if(!tacheId){
    alert("Enregistrez la tâche d'abord");
    return;
  }
  activateCreateInput(tacheId);
});
document.getElementById("btn-zoom-in").addEventListener("click", zoomAvant);
document.getElementById("btn-zoom-out").addEventListener("click", zoomArriere);
document.getElementById("btn-zoom-reset").addEventListener("click", zoomReinitialiser);
document.getElementById("btn-zoom-fit").addEventListener("click", zoomVueEnsemble);
document.getElementById("btn-debut").addEventListener("click", allerDebut);
document.getElementById("btn-debut").onclick = allerDebut;
document.getElementById("btn-today").addEventListener("click", allerAujourdhui);
document.getElementById("btn-today").onclick = allerAujourdhui;
document.getElementById("field-dupli-nom").addEventListener("input", majApercuDuplication);
document.getElementById("field-dupli-date-fin").addEventListener("input", majApercuDuplication);
document.getElementById("field-dupli-date-fin").addEventListener("change", majApercuDuplication);
setJourPx(ZOOM_DEFAUT);
grist.onRecords(()=>{ if(!DUPLI_EN_COURS) init(); });
init();
</script>
