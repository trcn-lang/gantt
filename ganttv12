// ============================================================================
// DÉTECTION AUTO DU SCHÉMA PARAMETRES (en cas de renommage par Grist)
// ============================================================================
let SCHEMA_PARAMETRES = { section: null, type: null, statut: null, equipe: null };

// Déterminer les vrais noms des champs dans PARAMETRES (Grist renomme les colonnes
// dupliquées, ex: "Section" → "Section" et "Section" → "$Section2"). Plutôt que de
// chercher par le CONTENU (signatures ambiguës), on cherche par le NOM de la colonne
// lui-même — c'est simple, explicite, et s'adapte à n'importe quelles données.
//
// PIÈGE CORRIGÉ : si PLUSIEURS colonnes matchent un même motif (ex: une colonne
// "Section" fantôme/vide ET "$Section2" qui contient les vraies valeurs), on ne
// peut pas se contenter de prendre la première trouvée — il faut vérifier laquelle
// contient réellement des données, sur TOUTES les lignes (pas juste la première).
function detectParametresSchema(){
  if(!DB.parametres || DB.parametres.length === 0) {
    console.log("❌ DB.parametres vide ou non chargée");
    return;
  }

  // Compte le nombre de valeurs non-vides pour une colonne donnée, sur toutes les lignes
  function nbValeursRemplies(field){
    return DB.parametres.filter(row => row[field] !== null && row[field] !== undefined && row[field] !== "").length;
  }

  const toutesLesColonnes = new Set();
  DB.parametres.forEach(row => Object.keys(row).forEach(k => toutesLesColonnes.add(k)));

  function trouverMeilleureColonne(predicat){
    // Parmi toutes les colonnes qui matchent le prédicat, retourne celle
    // avec le plus de valeurs remplies (la "vraie" colonne de données).
    const candidats = [...toutesLesColonnes].filter(f => f !== 'id' && predicat(f));
    if(candidats.length === 0) return null;
    if(candidats.length === 1) return candidats[0];
    let meilleur = candidats[0], meilleurScore = nbValeursRemplies(candidats[0]);
    for(const c of candidats.slice(1)){
      const score = nbValeursRemplies(c);
      if(score > meilleurScore){ meilleur = c; meilleurScore = score; }
    }
    return meilleur;
  }

  SCHEMA_PARAMETRES.section = trouverMeilleureColonne(f => /^\$?section\d*$/i.test(f));
  SCHEMA_PARAMETRES.type    = trouverMeilleureColonne(f => /^type[_ ]?projet$/i.test(f) || /^\$?type_?projet\d*$/i.test(f));
  SCHEMA_PARAMETRES.statut  = trouverMeilleureColonne(f => /^\$?statut\d*$/i.test(f));
  SCHEMA_PARAMETRES.equipe  = trouverMeilleureColonne(f => /^\$?(equipe|équipe)\d*$/i.test(f));

  // FALLBACK: si la détection par regex a échoué, essayer les noms en dur connus
  if(!SCHEMA_PARAMETRES.section && [...toutesLesColonnes].includes('$Section2')){
    SCHEMA_PARAMETRES.section = '$Section2';
    console.log("  ⚠️  Fallback: détection regex échouée, utilisant $Section2 directement");
  }
  if(!SCHEMA_PARAMETRES.type && [...toutesLesColonnes].includes('$Type_Projet2')){
    SCHEMA_PARAMETRES.type = '$Type_Projet2';
  }
  if(!SCHEMA_PARAMETRES.statut && [...toutesLesColonnes].includes('$Statut2')){
    SCHEMA_PARAMETRES.statut = '$Statut2';
  }
  if(!SCHEMA_PARAMETRES.equipe && [...toutesLesColonnes].includes('$Equipe2')){
    SCHEMA_PARAMETRES.equipe = '$Equipe2';
  }

  console.log("=== DÉTECTION SCHÉMA PARAMETRES (colonne avec le plus de données) ===");
  console.log("Colonnes disponibles:", [...toutesLesColonnes].sort());
  console.log("Schéma final:", SCHEMA_PARAMETRES);
  console.log("  Section → ", SCHEMA_PARAMETRES.section || "❌ NON TROUVÉE");
  console.log("  Type    → ", SCHEMA_PARAMETRES.type    || "❌ NON TROUVÉE");
  console.log("  Statut  → ", SCHEMA_PARAMETRES.statut  || "❌ NON TROUVÉE");
  console.log("  Equipe  → ", SCHEMA_PARAMETRES.equipe  || "❌ NON TROUVÉE");
  console.log("==========================================================");
}

